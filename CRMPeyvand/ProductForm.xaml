<Window x:Class="CRMPeyvand.ProductForm"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:CRMPeyvand"
        mc:Ignorable="d"
        ResizeMode="NoResize"
        WindowStyle="None"
        WindowStartupLocation="CenterScreen"
        Background="Transparent"
        AllowsTransparency="True"
        FlowDirection="RightToLeft"
        Title="ProductForm" Height="600" Width="1260" Loaded="Window_Loaded" PreviewKeyDown="Window_PreviewKeyDown">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition/>
            <ColumnDefinition/>
            <ColumnDefinition/>
            <ColumnDefinition/>
            <ColumnDefinition/>
            <ColumnDefinition/>
            <ColumnDefinition/>
            <ColumnDefinition/>
            <ColumnDefinition/>
            <ColumnDefinition/>
            <ColumnDefinition/>
            <ColumnDefinition/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition/>
            <RowDefinition/>
            <RowDefinition/>
            <RowDefinition/>
            <RowDefinition/>
            <RowDefinition/>
            <RowDefinition/>
            <RowDefinition/>
            <RowDefinition/>
            <RowDefinition/>
            <RowDefinition/>
            <RowDefinition/>
        </Grid.RowDefinitions>
        <!--Background-->
        <Border Grid.ColumnSpan="12" Grid.RowSpan="12" BorderThickness="5" BorderBrush="#eeeeee" CornerRadius="10">
            <Rectangle Fill="#eeeeee"/>
        </Border>
        <!--Background-->

        <!--ایجاد محصول-->
        <GroupBox Style="{StaticResource GroupBox}" Header="ایجاد کالا" Grid.ColumnSpan="12" Grid.RowSpan="3" Margin="10,5,10,15" />

        <Label Style="{StaticResource TextBoxLabel}"  Content=" نام کالا :" HorizontalAlignment="Left" Grid.Row="0" Grid.RowSpan="2" VerticalAlignment="Center" Margin="14,0,0,0"/>
        <Border Style="{StaticResource InputTextBoxBorder}" Grid.Column="1" Grid.ColumnSpan="3" HorizontalAlignment="Left" Grid.Row="0" Grid.RowSpan="2" VerticalAlignment="Center">
            <TextBox Style="{StaticResource InputTextBox}" x:Name="txtName" TabIndex="0"/>
        </Border>

        <!-- The unit is named on the label rather than inside the field: the field
             has to stay a plain number to be typed into, and a fixed-width field
             cannot hold the amount and the unit tight against each other. -->
        <Label Style="{StaticResource TextBoxLabel}" Grid.Column="4" Content="قیمت کالا (تومان) :" HorizontalAlignment="Left" Grid.Row="0" Grid.RowSpan="2" VerticalAlignment="Center" Margin="5,0,0,0"/>
        <Border Style="{StaticResource InputTextBoxBorder}" Grid.Column="5" Grid.ColumnSpan="3" HorizontalAlignment="Left" Grid.Row="0" Grid.RowSpan="2" VerticalAlignment="Center">
            <TextBox Style="{StaticResource InputTextBox}" Text="0" x:Name="txtPrice" TabIndex="1" GotFocus="txtTotal_GotFocus" TextChanged="txtPrice_TextChanged" PreviewKeyDown="txtPrice_PreviewKeyDown" ToolTip="قیمت به تومان"/>
        </Border>

        <Label Style="{StaticResource TextBoxLabel}" Grid.Column="8" Content="موجودی :" HorizontalAlignment="Left" Grid.Row="0" Grid.RowSpan="2" VerticalAlignment="Center" Margin="36,0,0,0"/>
        <Border Style="{StaticResource InputTextBoxBorder}" Grid.Column="9" Grid.ColumnSpan="3" HorizontalAlignment="Left" Grid.Row="0" Grid.RowSpan="2" VerticalAlignment="Center">
            <TextBox x:Name="txtTotal" Style="{StaticResource InputTextBox}" Text="0" GotFocus="txtTotal_GotFocus" TabIndex="2" TextChanged="txtPrice_TextChanged"/>
        </Border>
        <!--Personalize CheckBox-->
        <Rectangle Style="{StaticResource PersonalizeCheckBoxRectangle}" Grid.Row="1" Margin="24,43,56,32" MouseLeftButtonDown="IsService_MouseLeftButtonDown" Grid.RowSpan="2" MouseEnter="IsService_MouseEnter" MouseLeave="IsService_MouseLeave"/>
        <Border Style="{StaticResource PersonalizeCheckBoxBorder}" x:Name="IsService" Grid.Row="1" Margin="24,43,56,32" MouseLeftButtonDown="IsService_MouseLeftButtonDown" Grid.RowSpan="2" MouseEnter="IsService_MouseEnter" MouseLeave="IsService_MouseLeave">
            <Image Style="{StaticResource PersonalizeCheckBoxImage}" x:Name="IsServiceImage"/>
        </Border>
        <Label Style="{StaticResource TextBoxLabel}" x:Name="chkbxLabel" FontSize="14" Grid.Column="0" Grid.ColumnSpan="4" Content="کالا من خدمات است و نیاز به موجودی ندارد." HorizontalAlignment="Left" Grid.Row="1" VerticalAlignment="Top" Margin="55,41,0,0" Grid.RowSpan="2" MouseLeftButtonDown="IsService_MouseLeftButtonDown" MouseEnter="IsService_MouseEnter" MouseLeave="IsService_MouseLeave" Cursor="Hand"/>
        <!--Personalize CheckBox-->
        <!--btnAddProduct-->
        <Border Style="{StaticResource ButtonBorder}" x:Name="btnAddProductBorder" Grid.Column="10" Grid.ColumnSpan="2" HorizontalAlignment="Left" Grid.Row="1" Grid.RowSpan="2" VerticalAlignment="Center" Margin="15,0,0,0" >
            <Button Style="{StaticResource Button}" x:Name="btnAddProduct" Content="ثبت کالا" TabIndex="3" Click="btnAddProduct_Click"/>
        </Border>
        <!--btnAddProduct-->
        <!--ایجاد محصول-->

        <!--جستجوی محصول-->
        <GroupBox Style="{StaticResource GroupBox}" Header="جستجوی کالا" Grid.Row="3" Grid.RowSpan="2" Grid.ColumnSpan="12" Margin="10,0,10,25"/>
        <Border Style="{StaticResource InputTextBoxBorder}" Grid.Column="0" Grid.ColumnSpan="12"  HorizontalAlignment="Left" VerticalAlignment="Center" Grid.Row="3" Grid.RowSpan="2" Margin="30,0,0,0" Width="1200">
            <TextBox Style="{StaticResource InputTextBox}" x:Name="txtSearchProduct" TextChanged="txtSearchProduct_TextChanged"/>
        </Border>
        <Image Source="/Images/Search.png" Grid.Column="11" Grid.Row="3" Grid.RowSpan="2" Height="25"/>
        <!--جستجوی محصول-->

        <!--نمایش محصولات-->
        <Border Style="{StaticResource DataGridBorder}" Grid.Column="0" Grid.ColumnSpan="12" Grid.Row="5" Grid.RowSpan="6"  Margin="10,0,10,0">
            <DataGrid Style="{StaticResource DataGrid}" x:Name="dgvProducts" ContextMenuOpening="dgvProducts_ContextMenuOpening">
                <DataGrid.ContextMenu>
                    <ContextMenu Style="{StaticResource ContextMenu}">
                        <MenuItem Style="{StaticResource MenuItem}" x:Name="miEdit" Header="ویرایش اطلاعات کالا" Click="miEdit_Click">
                            <MenuItem.Icon>
                                <Image Source="/Images/Edit.png"/>
                            </MenuItem.Icon>
                        </MenuItem>
                        <MenuItem Style="{StaticResource MenuItem}" x:Name="miDelete" Header="حذف کالا" Click="miDelete_Click">
                            <MenuItem.Icon>
                                <Image Source="/Images/Delete.png"/>
                            </MenuItem.Icon>
                        </MenuItem>
                    </ContextMenu>
                </DataGrid.ContextMenu>
            </DataGrid>
        </Border>
        <!--نمایش محصولات-->

        <!--منوی پایین-->
        <Image Style="{StaticResource BackToHomeImage}" x:Name="BackToHome" MouseLeftButtonDown="BackToHome_MouseLeftButtonDown"/>
        <Label Style="{StaticResource TextBoxLabel}" FontSize="14" Grid.Column="0" Grid.ColumnSpan="2" Content="تعداد کالاهای ثبت شده :" HorizontalAlignment="Left" Grid.Row="11" VerticalAlignment="Center" Margin="10,0,0,0" Grid.RowSpan="1" />
        <Label Style="{StaticResource TextBoxLabel}" x:Name="ProductCount" FontSize="20" FontWeight="Bold" Grid.Column="1" Grid.ColumnSpan="2" Content="0" HorizontalAlignment="Center" Grid.Row="11" VerticalAlignment="Center" Margin="0,0,0,0"/>
        <!--منوی پایین-->
    </Grid>

</Window>
