<Window x:Class="CRMPeyvand.UserPictureForm"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:CRMPeyvand"
        mc:Ignorable="d"
                        ResizeMode="NoResize"
        WindowStyle="None"
        WindowStartupLocation="CenterScreen"
        Background="Transparent"
        AllowsTransparency="True"
        FlowDirection="RightToLeft"
        Title="UserPictureForm" Height="200" Width="150" Loaded="Window_Loaded" PreviewKeyDown="Window_PreviewKeyDown">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition/>
            <ColumnDefinition/>
            <ColumnDefinition/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition/>
            <RowDefinition/>
            <RowDefinition/>
        </Grid.RowDefinitions>
        <!--Background-->
        <Border Grid.ColumnSpan="12" Grid.RowSpan="12" BorderThickness="5" BorderBrush="#eeeeee" CornerRadius="10">
            <Rectangle Fill="#eeeeee"/>
        </Border>
        <!--Background-->

        <Border  Height="150" Width="150" BorderBrush="#4A8FE7" BorderThickness="3" CornerRadius="6" Grid.Column="0" Grid.ColumnSpan="3" Grid.RowSpan="3" Margin="0,0,0,50">
            <Image Source="/Images/User.png" x:Name="picBoxUser" Stretch="Fill" ToolTip=" برای وارد کردن عکس کاربر کلیک کنید" MouseLeftButtonDown="Image_MouseLeftButtonDown"/>
        </Border>
        <Image Style="{StaticResource BackToHomeImage}" Grid.Column="2" Margin="18,33,10,9" Height="25" Grid.Row="2" RenderTransformOrigin="0.109,0.607" MouseLeftButtonDown="Image_MouseLeftButtonDown"/>
    </Grid>
</Window>
