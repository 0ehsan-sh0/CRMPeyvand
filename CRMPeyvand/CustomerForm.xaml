<Window x:Class="CRMPeyvand.CustomerForm"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:CRMPeyvand"
        mc:Ignorable="d"
                ResizeMode="NoResize"
        WindowStyle="None"
        WindowStartupLocation="CenterScreen"
        Background="Transparent"
        AllowsTransparency="True"
        FlowDirection="RightToLeft"
        Title="CustomerForm" Height="600" Width="1260" Loaded="Window_Loaded" PreviewKeyDown="Window_PreviewKeyDown">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition/>
            <ColumnDefinition/>
            <ColumnDefinition/>
            <ColumnDefinition/>
            <ColumnDefinition/>
            <ColumnDefinition/>
            <ColumnDefinition/>
            <ColumnDefinition/>
            <ColumnDefinition/>
            <ColumnDefinition/>
            <ColumnDefinition/>
            <ColumnDefinition/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition/>
            <RowDefinition/>
            <RowDefinition/>
            <RowDefinition/>
            <RowDefinition/>
            <RowDefinition/>
            <RowDefinition/>
            <RowDefinition/>
            <RowDefinition/>
            <RowDefinition/>
            <RowDefinition/>
            <RowDefinition/>
        </Grid.RowDefinitions>
        <!--Background-->
        <Border Grid.ColumnSpan="12" Grid.RowSpan="12" BorderThickness="5" BorderBrush="#eeeeee" CornerRadius="10">
            <Rectangle Fill="#eeeeee"/>
        </Border>

        <!--Background-->

        <!--اضافه کردن مشتری-->
        <GroupBox Style="{StaticResource GroupBox}" Header="اضافه کردن مشتری" Grid.ColumnSpan="12" Grid.RowSpan="2" Margin="10,5,10,15" />

        <Label Style="{StaticResource TextBoxLabel}"  Content=" نام :" HorizontalAlignment="Left" Grid.Row="0" Grid.RowSpan="2" VerticalAlignment="Top" Margin="20,37,0,0"/>
        <Border Style="{StaticResource InputTextBoxBorder}" Grid.ColumnSpan="4" HorizontalAlignment="Center" Grid.Row="0" Grid.RowSpan="2" VerticalAlignment="Center">
            <TextBox Style="{StaticResource InputTextBox}" x:Name="txtName" TabIndex="0" TextChanged="txtName_TextChanged"/>
        </Border>

        <Label Style="{StaticResource TextBoxLabel}" Grid.Column="3" Content="شماره تلفن :" HorizontalAlignment="Left" Grid.Row="0" Grid.RowSpan="2" VerticalAlignment="Top" Margin="77,37,0,0" Grid.ColumnSpan="2"/>
        <Border Style="{StaticResource InputTextBoxBorder}" Grid.Column="4" Grid.ColumnSpan="4" HorizontalAlignment="Center" Grid.Row="0" Grid.RowSpan="2" VerticalAlignment="Center">
            <Grid>
                <TextBox Style="{StaticResource InputTextBox}" x:Name="txtPhone" TabIndex="1" TextChanged="txtPhone_TextChanged"/>
                <!-- An example of the shape the field wants. WPF has no placeholder
                     of its own, and the field's own background is opaque, so the
                     hint cannot sit underneath it: txtPhone_TextChanged shows and
                     hides it instead. -->
                <TextBlock x:Name="lblPhoneHint" Text="09120000012" FontFamily="Shabnam FD" FontSize="13"
                           Foreground="#9aa3b2" Margin="5,4,0,0" TextAlignment="Right"
                           IsHitTestVisible="False" Visibility="Collapsed"/>
            </Grid>
        </Border>

        <!--btnAddCustomer-->
        <Border Style="{StaticResource ButtonBorder}" x:Name="btnAddProductBorder" Grid.Column="10" Grid.ColumnSpan="2" HorizontalAlignment="Left" Grid.Row="0" Grid.RowSpan="2" VerticalAlignment="Center" Margin="15,0,0,0" >
            <Button Style="{StaticResource Button}" x:Name="btnAddProduct" Content="ثبت مشتری" TabIndex="2" Click="btnAddProduct_Click"/>
        </Border>
        <!--btnAddCustomer-->

        <!--اضافه کردن مشتری-->

        <!--جستجوی مشتری-->
        <GroupBox Style="{StaticResource GroupBox}" Header="جستجوی مشتری" Grid.Row="2" Grid.RowSpan="2" Grid.ColumnSpan="12" Margin="10,0,10,25"/>
        <Border Style="{StaticResource InputTextBoxBorder}" Grid.Column="0" Grid.ColumnSpan="12"  HorizontalAlignment="Left" VerticalAlignment="Center" Grid.Row="2" Grid.RowSpan="2" Margin="30,0,0,0" Width="1200">
            <TextBox Style="{StaticResource InputTextBox}" x:Name="txtSearchCustomer" TabIndex="3" TextChanged="txtSearchCustomer_TextChanged"/>
        </Border>
        <Image Source="/Images/Search.png" Grid.Column="11" Grid.Row="2" Grid.RowSpan="2" Height="25"/>
        <!--جستجوی مشتری-->

        <!--نمایش مشتریان-->
        <Border Style="{StaticResource DataGridBorder}" Grid.Column="0" Grid.ColumnSpan="12" Grid.Row="4" Grid.RowSpan="7"  Margin="10,0,10,0">
            <DataGrid Style="{StaticResource DataGrid}" x:Name="dgvCustomer" ContextMenuOpening="dgvCustomer_ContextMenuOpening">
                <DataGrid.ContextMenu>
                    <ContextMenu Style="{StaticResource ContextMenu}">
                        <MenuItem Style="{StaticResource MenuItem}" x:Name="EditCustomerMI" Header="ویرایش اطلاعات مشتری" Click="EditCustomerMI_Click">
                            <MenuItem.Icon>
                                <Image Source="/Images/Edit.png"/>
                            </MenuItem.Icon>
                        </MenuItem>
                        <MenuItem Style="{StaticResource MenuItem}" x:Name="DeleteCustomer" Header="حذف مشتری" Click="DeleteCustomer_Click">
                            <MenuItem.Icon>
                                <Image Source="/Images/Delete.png"/>
                            </MenuItem.Icon>
                        </MenuItem>
                    </ContextMenu>
                </DataGrid.ContextMenu>
            </DataGrid>
        </Border>
        <!--نمایش مشتریان-->

        <!--منوی پایین-->
        <Image Style="{StaticResource BackToHomeImage}" x:Name="BackToHome" MouseLeftButtonDown="BackToHome_MouseLeftButtonDown"/>
        <Label Style="{StaticResource TextBoxLabel}" FontSize="14" Grid.Column="0" Grid.ColumnSpan="2" Content="تعداد مشتریان تا به الان :" HorizontalAlignment="Left" Grid.Row="11" VerticalAlignment="Center" Margin="10,0,0,0" Grid.RowSpan="1"/>
        <Label Style="{StaticResource TextBoxLabel}" x:Name="Count" FontSize="20" FontWeight="Bold" Grid.Column="1" Grid.ColumnSpan="2" Content="0" HorizontalAlignment="Center" Grid.Row="11" VerticalAlignment="Center" Margin="0,0,0,0"/>
        <!--منوی پایین-->

    </Grid>
</Window>
