<Window x:Class="CRMPeyvand.DatabaseGuideForm"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:CRMPeyvand"
        mc:Ignorable="d"

        ResizeMode="NoResize"
        WindowStyle="None"
        WindowStartupLocation="CenterScreen"
        Background="Transparent"
        AllowsTransparency="True"
        FlowDirection="RightToLeft"

        Title="DatabaseGuideForm" Height="520" Width="620"
        PreviewKeyDown="Window_PreviewKeyDown">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="46"/>
        </Grid.RowDefinitions>

        <Border Grid.Column="0" Grid.Row="0" BorderThickness="5" BorderBrush="#eeeeee" CornerRadius="10">
            <Rectangle Fill="#eeeeee"/>
        </Border>

        <Grid Grid.Column="0" Grid.Row="0" Margin="8,10,8,4">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <GroupBox Style="{StaticResource GroupBox}" Header="راهنمای پیکربندی اتصال به پایگاه داده"
                      Grid.Column="0" Grid.Row="0"/>

            <ScrollViewer Grid.Column="0" Grid.Row="0" Margin="14,26,14,10"
                          VerticalScrollBarVisibility="Auto">
                <StackPanel>

                    <TextBlock FontFamily="Shabnam FD" FontSize="13" FontWeight="Bold" Foreground="#0d63f1"
                               Text="پایگاه داده SQLite" Margin="0,0,0,6"/>
                    <TextBlock FontFamily="Shabnam FD" FontSize="11" Foreground="#333333"
                               TextWrapping="Wrap" LineHeight="19" Margin="0,0,0,16"
                               Text="برنامه به طور پیش‌فرض روی SQLite کار می‌کند و برای اجرای آن نیازی به نصب هیچ برنامه دیگری نیست. فایل پایگاه داده به صورت خودکار در پوشه داده ساخته می‌شود و مسیر آن در صفحه تنظیمات نمایش داده می‌شود."/>

                    <TextBlock FontFamily="Shabnam FD" FontSize="13" FontWeight="Bold" Foreground="#0d63f1"
                               Text="پیش‌نیازهای SQL Server" Margin="0,0,0,6"/>
                    <TextBlock FontFamily="Shabnam FD" FontSize="11" Foreground="#333333"
                               TextWrapping="Wrap" LineHeight="19" Margin="0,0,0,16"
                               Text="برای استفاده از SQL Server باید نسخه ۲۰۱۶ یا بالاتر از SQL Server روی همان رایانه‌ای که برنامه اجرا می‌شود نصب باشد. نیازی به نصب SQL Server Management Studio نیست."/>

                    <TextBlock FontFamily="Shabnam FD" FontSize="13" FontWeight="Bold" Foreground="#0d63f1"
                               Text="نام سرور" Margin="0,0,0,6"/>
                    <TextBlock FontFamily="Shabnam FD" FontSize="11" Foreground="#333333"
                               TextWrapping="Wrap" LineHeight="19" Margin="0,0,0,16"
                               Text="اگر SQL Server به صورت نمونه پیش‌فرض روی همین رایانه نصب شده باشد، در قسمت نام سرور نقطه (.) را وارد کنید. اگر چند نمونه با نام نصب شده‌اند، نام همان نمونه را بنویسید؛ برای نمونه SQLExpress."/>

                    <TextBlock FontFamily="Shabnam FD" FontSize="13" FontWeight="Bold" Foreground="#0d63f1"
                               Text="نام پایگاه داده" Margin="0,0,0,6"/>
                    <TextBlock FontFamily="Shabnam FD" FontSize="11" Foreground="#333333"
                               TextWrapping="Wrap" LineHeight="19" Margin="0,0,0,16"
                               Text="اگر این قسمت خالی گذاشته شود، خود برنامه پایگاه داده را با جدول‌های لازم می‌سازد. اگر از قبل پایگاه داده‌ای دارید، نام همان را وارد کنید. توجه داشته باشید که داده‌های SQLite و SQL Server کاملاً از یکدیگر جدا هستند و با تغییر این مقدار، اطلاعات بین آن‌ها جابه‌جا نمی‌شود."/>

                    <TextBlock FontFamily="Shabnam FD" FontSize="13" FontWeight="Bold" Foreground="#0d63f1"
                               Text="نام کاربری و کلمه عبور" Margin="0,0,0,6"/>
                    <TextBlock FontFamily="Shabnam FD" FontSize="11" Foreground="#333333"
                               TextWrapping="Wrap" LineHeight="19" Margin="0,0,0,16"
                               Text="توصیه می‌شود گزینه استفاده از حساب ویندوز انتخاب شود. در این حالت نام کاربری و کلمه عبور نادیده گرفته می‌شوند و نیازی به ذخیره کلمه عبور در رایانه نیست. اگر این گزینه انتخاب نشود، کلمه عبور در فایل تنظیمات برنامه به صورت متن ساده ذخیره می‌شود."/>

                    <TextBlock FontFamily="Shabnam FD" FontSize="13" FontWeight="Bold" Foreground="#0d63f1"
                               Text="ذخیره و فعال سازی" Margin="0,0,0,6"/>
                    <TextBlock FontFamily="Shabnam FD" FontSize="11" Foreground="#333333"
                               TextWrapping="Wrap" LineHeight="19" Margin="0,0,0,16"
                               Text="پس از پر کردن اطلاعات، ابتدا دکمه آزمایش اتصال را بزنید. تنها در صورتی که اتصال موفق باشد، دکمه ذخیره و فعال سازی اطلاعات را ذخیره می‌کند؛ پس اگر اطلاعات اشتباه باشد هیچ تغییری ذخیره نخواهد شد. پس از ذخیره باید برنامه را دوباره اجرا کنید."/>

                    <TextBlock FontFamily="Shabnam FD" FontSize="13" FontWeight="Bold" Foreground="#0d63f1"
                               Text="غیرفعال کردن اتصال" Margin="0,0,0,6"/>
                    <TextBlock FontFamily="Shabnam FD" FontSize="11" Foreground="#333333"
                               TextWrapping="Wrap" LineHeight="19" Margin="0,0,0,16"
                               Text="اگر می‌خواهید برنامه موقتاً روی SQLite کار کند، دکمه غیرفعال کردن اتصال SQL Server را بزنید. در این حالت برنامه به SQLite برمی‌گردد، اما اطلاعات اتصال ذخیره شده حذف نمی‌شود و هر زمان بخواهید می‌توانید دوباره آن را فعال کنید."/>

                    <TextBlock FontFamily="Shabnam FD" FontSize="13" FontWeight="Bold" Foreground="#0d63f1"
                               Text="پشتیبان گیری" Margin="0,0,0,6"/>
                    <TextBlock FontFamily="Shabnam FD" FontSize="11" Foreground="#333333"
                               TextWrapping="Wrap" LineHeight="19"
                               Text="پیش از انجام تغییرات مهم، از دکمه پشتیبان گیری استفاده کنید. این دکمه روی هر دو نوع پایگاه داده کار می‌کند و یک فایل پشتیبان قابل بازیابی می‌سازد."/>

                </StackPanel>
            </ScrollViewer>
        </Grid>

        <Image Style="{StaticResource BackToHomeImage}" x:Name="BackToSetting"
               Grid.Column="0" Grid.Row="1" HorizontalAlignment="Left" VerticalAlignment="Center"
               Margin="12,0,0,0" Cursor="Hand" MouseLeftButtonDown="BackToSetting_MouseLeftButtonDown"/>
    </Grid>
</Window>
