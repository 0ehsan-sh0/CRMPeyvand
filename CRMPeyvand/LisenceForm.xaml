<UserControl x:Class="CRMPeyvand.LisenceForm"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:CRMPeyvand"
             mc:Ignorable="d" 
             FlowDirection="RightToLeft"
             d:DesignHeight="500" d:DesignWidth="450" Loaded="UserControl_Loaded">
    <Grid x:Name="MainGrid">
        <Grid.ColumnDefinitions>
            <ColumnDefinition/>
            <ColumnDefinition/>
            <ColumnDefinition/>
            <ColumnDefinition/>
            <ColumnDefinition/>
            <ColumnDefinition/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition/>
            <RowDefinition/>
            <RowDefinition/>
            <RowDefinition/>
            <RowDefinition/>
            <RowDefinition/>
        </Grid.RowDefinitions>
        <Label Style="{StaticResource TextBoxLabel}" x:Name="lblWelcome" HorizontalAlignment="Center" FontWeight="Bold" FontSize="23" Content="به نرم افزار پیوند خوش آمدید" Foreground="#ffffff" Grid.Column="1" Grid.ColumnSpan="4" Margin="0,0,0,40" Width="294"/>
        <Label Style="{StaticResource TextBoxLabel}" x:Name="lblDetails" HorizontalAlignment="Left" FontWeight="Medium" FontSize="12" Content="کد سیستم را به شرکت تحویل داده و لایسنس را خود را وارد کنید" Foreground="#ffffff" Grid.ColumnSpan="6" Margin="66,34,0,6" Width="326" Grid.Row="2"/>

        <Image Source="/Images/UserWhite.png" x:Name="img" Grid.Column="1" Grid.ColumnSpan="4" Margin="58,20,58,20" Grid.RowSpan="3" />

        <Border Style="{StaticResource InputTextBoxBorder}" x:Name="borderName" BorderBrush="White" Grid.ColumnSpan="4" Margin="3,68,3,68" Grid.Row="2" Grid.Column="1" Grid.RowSpan="2">
            <TextBox Style="{StaticResource InputTextBox}" IsEnabled="False" Background="White" x:Name="txtName"  TabIndex="0" ToolTip="کد سیستم" PreviewMouseLeftButtonDown="txtName_PreviewMouseLeftButtonDown"/>
        </Border>
        <Rectangle x:Name="rcCopy" Fill="White" Opacity="0" Grid.Column="1" Grid.ColumnSpan="4" Margin="3,68,3,68" Grid.RowSpan="2" Grid.Row="2" MouseLeftButtonDown="txtName_PreviewMouseLeftButtonDown"/>
        <Border Style="{StaticResource InputTextBoxBorder}" x:Name="borderLisence" BorderBrush="White" Grid.ColumnSpan="4" Margin="3,27,2,26" Grid.Row="3" Grid.Column="1">
            <TextBox Style="{StaticResource InputTextBox}" Background="White" x:Name="txtLisence" TabIndex="1"/>
        </Border>

        <Border Style="{StaticResource ButtonBorder}" x:Name="btnBorder" BorderBrush="White" HorizontalAlignment="Center" Height="30" Width="248" Grid.ColumnSpan="4" Margin="0,83,0,54" Grid.Column="1" Grid.Row="3" Grid.RowSpan="2">
            <Button Style="{StaticResource Button}" Foreground="Black" FontWeight="Bold" Background="White" x:Name="btnLicense" HorizontalAlignment="Center" VerticalAlignment="Center" Width="248" Content="تایید لایسنس" TabIndex="4" Click="btnLicense_Click"/>
        </Border>

    </Grid>
</UserControl>
