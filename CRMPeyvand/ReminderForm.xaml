<Window x:Class="CRMPeyvand.ReminderForm"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:hc="https://handyorg.github.io/handycontrol"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:CRMPeyvand"
        mc:Ignorable="d"
                ResizeMode="NoResize"
        WindowStyle="None"
        WindowStartupLocation="CenterScreen"
        Background="Transparent"
        AllowsTransparency="True"
        FlowDirection="RightToLeft"
        Title="ReminderForm" Height="600" Width="1260" Loaded="Window_Loaded" PreviewKeyDown="Window_PreviewKeyDown">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition/>
            <ColumnDefinition/>
            <ColumnDefinition/>
            <ColumnDefinition/>
            <ColumnDefinition/>
            <ColumnDefinition/>
            <ColumnDefinition/>
            <ColumnDefinition/>
            <ColumnDefinition/>
            <ColumnDefinition/>
            <ColumnDefinition/>
            <ColumnDefinition/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition/>
            <RowDefinition/>
            <RowDefinition Height="50"/>
            <RowDefinition/>
            <RowDefinition/>
            <RowDefinition/>
            <RowDefinition/>
            <RowDefinition/>
            <RowDefinition/>
            <RowDefinition/>
            <RowDefinition/>
            <RowDefinition/>
        </Grid.RowDefinitions>
        <!--Background-->
        <Border Grid.ColumnSpan="12" Grid.RowSpan="12" BorderThickness="5" BorderBrush="#eeeeee" CornerRadius="10">
            <Rectangle Fill="#eeeeee"/>
        </Border>
        <!--Background-->

        <!--ایجاد یادآور-->
        <GroupBox Style="{StaticResource GroupBox}" Header="ایجاد یادآور" Grid.ColumnSpan="12" Grid.RowSpan="3" Margin="10,5,10,15" />
        <hc:PersianDatePicker x:Name="DatePicker" FontFamily="Shabnam FD" FontWeight="Bold" Grid.Column="10" Grid.ColumnSpan="2" Grid.RowSpan="2" Margin="14,35,21,35" TabIndex="3"/>
        <Label Style="{StaticResource TextBoxLabel}"  Content="جستجو کاربر بر اساس نام :" HorizontalAlignment="Left" Grid.Row="0" Grid.RowSpan="2" Grid.ColumnSpan="2" VerticalAlignment="Top" Margin="20,37,0,0"/>
        <Border Style="{StaticResource InputTextBoxBorder}" HorizontalAlignment="Left" Grid.Row="0" Grid.RowSpan="2" VerticalAlignment="Center" Grid.Column="1" Grid.ColumnSpan="4" Margin="77,0,0,0">
            <!--<TextBox Style="{StaticResource InputTextBox}" x:Name="txtUser" TabIndex="0"/>-->
            <hc:ComboBox Style="{StaticResource ComboBox}" IsEditable="True" x:Name="txtUser" Padding="0,5,0,0" SelectionChanged="txtUser_SelectionChanged" TabIndex="0"/>
        </Border>

        <Label Style="{StaticResource TextBoxLabel}" Grid.Column="0" Content="موضوع یادآور :" HorizontalAlignment="Left" Grid.Row="1" Grid.RowSpan="2" VerticalAlignment="Top" Margin="20,33,0,0"/>
        <Border Style="{StaticResource InputTextBoxBorder}" Grid.Column="1" HorizontalAlignment="Left" Grid.Row="1" Grid.RowSpan="2" VerticalAlignment="Top" Grid.ColumnSpan="4" Margin="77,33,0,0">
            <TextBox Style="{StaticResource InputTextBox}" x:Name="txtTopic" TabIndex="1"/>
        </Border>

        <Border Style="{StaticResource InputTextBoxBorder}" Height="76" Grid.Column="5" HorizontalAlignment="Left" Grid.Row="0" Grid.RowSpan="3" VerticalAlignment="Center" Grid.ColumnSpan="4" Margin="20,0,0,0" Width="400">
            <TextBox Style="{StaticResource DescriptionInputTextBox}" x:Name="txtReminderInfo" TabIndex="2"/>
        </Border>
        <!--btnAddReminder-->
        <Border Style="{StaticResource ButtonBorder}" x:Name="btnAddReminderBorder" Grid.Column="10" Grid.ColumnSpan="2" HorizontalAlignment="Left" Grid.Row="1" Grid.RowSpan="2" VerticalAlignment="Center" Margin="15,0,0,0" >
            <Button Style="{StaticResource Button}" x:Name="btnAddReminder" Content="ثبت یادآور" TabIndex="4" Click="btnAddReminder_Click"/>
        </Border>
        <!--btnAddReminder-->

        <!--ایجاد یادآور-->

        <!--جستجوی مشتری-->
        <GroupBox Style="{StaticResource GroupBox}" Header="جستجوی یادآور" Grid.Row="3" Grid.RowSpan="2" Grid.ColumnSpan="12" Margin="10,0,10,25"/>
        <Border Style="{StaticResource InputTextBoxBorder}" Grid.Column="0" Grid.ColumnSpan="12"  HorizontalAlignment="Left" VerticalAlignment="Center" Grid.Row="3" Grid.RowSpan="2" Margin="30,0,0,0" Width="1200">
            <TextBox Style="{StaticResource InputTextBox}" x:Name="txtSearchReminder" TextChanged="txtSearchReminder_TextChanged" TabIndex="5" ToolTip="میتوانید بر اساس موضوع و یا توضیحات یادآور جستجو کنید"/>
        </Border>
        <Image Source="/Images/Search.png" Grid.Column="11" Grid.Row="3" Grid.RowSpan="2" Height="25"/>
        <!--جستجوی مشتری-->
        <!--نمایش محصولات-->
        <Border Style="{StaticResource DataGridBorder}" Grid.Column="0" Grid.ColumnSpan="12" Grid.Row="5" Grid.RowSpan="6"  Margin="10,0,10,0">
            <DataGrid Style="{StaticResource DataGrid}" x:Name="dgvReminders" ContextMenuOpening="dgvReminders_ContextMenuOpening">
                <DataGrid.ContextMenu>
                    <ContextMenu Style="{StaticResource ContextMenu}">
                        <MenuItem Style="{StaticResource MenuItem}" x:Name="miEdit" Header="ویرایش یادآور" Click="miEdit_Click">
                            <MenuItem.Icon>
                                <Image Source="/Images/Edit.png"/>
                            </MenuItem.Icon>
                        </MenuItem>
                        <MenuItem Style="{StaticResource MenuItem}" x:Name="miDone" Header="انجام شد" Click="miDone_Click">
                            <MenuItem.Icon>
                                <Image Source="/Images/Checked.png"/>
                            </MenuItem.Icon>
                        </MenuItem>
                        <MenuItem Style="{StaticResource MenuItem}" x:Name="miDelete" Header="حذف یادآور" Click="miDelete_Click">
                            <MenuItem.Icon>
                                <Image Source="/Images/Delete.png"/>
                            </MenuItem.Icon>
                        </MenuItem>
                    </ContextMenu>
                </DataGrid.ContextMenu>

            </DataGrid>
        </Border>
        <!--نمایش محصولات-->


        <!--منوی پایین-->
        <Image Style="{StaticResource BackToHomeImage}" x:Name="BackToHome" MouseLeftButtonDown="BackToHome_MouseLeftButtonDown"/>
        <Label Style="{StaticResource TextBoxLabel}" FontSize="14" Grid.Column="0" Grid.ColumnSpan="2" Content="تعداد یادآور های ثبت شده :" HorizontalAlignment="Left" Grid.Row="11" VerticalAlignment="Center" Margin="10,0,0,0" Grid.RowSpan="1" />
        <Label Style="{StaticResource TextBoxLabel}" x:Name="lblCount" FontSize="20" FontWeight="Bold" Grid.Column="1" Grid.ColumnSpan="2" Content="0" HorizontalAlignment="Center" Grid.Row="11" VerticalAlignment="Center" Margin="0,0,0,0"/>
        <!--منوی پایین-->

    </Grid>

</Window>
