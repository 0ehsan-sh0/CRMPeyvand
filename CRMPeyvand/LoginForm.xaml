<Window
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:CRMPeyvand"
        xmlns:hc="https://handyorg.github.io/handycontrol" x:Class="CRMPeyvand.LoginForm"
        mc:Ignorable="d"
                ResizeMode="NoResize"
        WindowStyle="None"
        WindowStartupLocation="CenterScreen"
        Background="Transparent"
        AllowsTransparency="True"
        FlowDirection="RightToLeft"

        Title="UsersForm" Height="600" Width="1260" Loaded="Window_Loaded" ContentRendered="Timer_Tike">
    <Grid x:Name="MainGrid">
        <Grid.ColumnDefinitions>
            <ColumnDefinition/>
            <ColumnDefinition/>
            <ColumnDefinition/>
            <ColumnDefinition/>
            <ColumnDefinition/>
            <ColumnDefinition/>
            <ColumnDefinition/>
            <ColumnDefinition/>
            <ColumnDefinition/>
            <ColumnDefinition/>
            <ColumnDefinition/>
            <ColumnDefinition/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition/>
            <RowDefinition/>
            <RowDefinition/>
            <RowDefinition/>
            <RowDefinition/>
            <RowDefinition/>
            <RowDefinition/>
            <RowDefinition/>
            <RowDefinition/>
            <RowDefinition/>
            <RowDefinition/>
            <RowDefinition/>
        </Grid.RowDefinitions>
        <!--Background-->
        <Border Grid.ColumnSpan="12" Grid.RowSpan="12" BorderThickness="5" BorderBrush="#4A8FE7" CornerRadius="10">
            <Rectangle Fill="#4A8FE7"/>
        </Border>
        <!--Background-->
        <Image Source="/Images/ExitWhite.png" Name="Exit" Grid.Row="10" Grid.Column="11" Height="35" Cursor="Hand" MouseLeftButtonDown="Exit_MouseLeftButtonDown" ToolTip="خروج" Margin="0,43,0,22" Grid.RowSpan="2"/>

        <Image Source="/Images/PeyvandLogoWhite.png" x:Name="imgLoad" Grid.Column="5" Grid.ColumnSpan="2" Margin="31,21,35,35" Grid.Row="3" Grid.RowSpan="4" />
        <Label Style="{StaticResource TextBoxLabel}" x:Name="lblLoad" FontWeight="Bold" FontSize="23" Content="لطفا صبور باشید ..." Foreground="#ffffff" Grid.Column="5" Grid.ColumnSpan="3" Margin="13,29,104,25" Grid.Row="6" Grid.RowSpan="2"/>
        <ProgressBar x:Name="pbLoad" Grid.ColumnSpan="12" Value="0" FontSize="0.1" Minimum="0" Maximum="100" Margin="25,45,25,25" Grid.Row="10" Height="30" Grid.RowSpan="2" RenderTransformOrigin="0.5,0.5">
            <ProgressBar.RenderTransform>
                <TransformGroup>
                    <ScaleTransform/>
                    <SkewTransform/>
                    <RotateTransform Angle="180"/>
                    <TranslateTransform/>
                </TransformGroup>
            </ProgressBar.RenderTransform>
        </ProgressBar>
        <Label Style="{StaticResource TextBoxLabel}" x:Name="lblWelcome" FontWeight="Bold" FontSize="23" Visibility="Hidden" Content="به نرم افزار پیوند خوش آمدید" Foreground="#ffffff" Grid.Column="4" Grid.ColumnSpan="4" Margin="67,10,67,44" Grid.Row="5" Grid.RowSpan="2"/>

    </Grid>
</Window>
