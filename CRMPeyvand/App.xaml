<Application x:Class="CRMPeyvand.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:CRMPeyvand"
             xmlns:hc="https://handyorg.github.io/handycontrol"
             xmlns:lvc="clr-namespace:LiveCharts.Wpf;assembly=LiveCharts.Wpf"
             StartupUri="MainWindow.xaml">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <hc:ThemeResources/>
                <hc:Theme/>
                <!-- Other merged dictionaries here -->
            </ResourceDictionary.MergedDictionaries>
            <!-- Other app resources here -->

            <!--MainWindowLabels-->
            <Style x:Key="MainWindowLabels" TargetType="Label">
                <Setter Property="Background" Value="Transparent"/>
                <Setter Property="BorderBrush" Value="Transparent"/>
            </Style>

            <!--MainWindowLabels-->

            <!--InputTextBox-->
            <Style x:Key="InputTextBox" TargetType="TextBox">
                <Setter Property="TextWrapping" Value="Wrap"/>
                <Setter Property="FontSize" Value="13"/>
                <Setter Property="Background" Value="#eeeeee"/>
                <Setter Property="BorderBrush" Value="#eeeeee"/>
                <Setter Property="FontFamily" Value="Shabnam FD"/>
                <Setter Property="FontWeight" Value="Bold"/>
                <Setter Property="Padding" Value="5,4,0,0"/>
            </Style>
            <Style x:Key="InputTextBoxBorder" TargetType="Border">
                <Setter Property="Width" Value="295"/>
                <Setter Property="Height" Value="30"/>
                <Setter Property="BorderThickness" Value="2"/>
                <Setter Property="BorderBrush" Value="#eeeeee"/>
                <Setter Property="CornerRadius" Value="5"/>
            </Style>
            <Style x:Key="TextBoxLabel" TargetType="Label">
                <Setter Property="FontFamily" Value="Shabnam FD"/>
                <Setter Property="FontSize" Value="13"/>
            </Style>
            <!--InputTextBox-->

            <!--DescriptionInputTextBox-->
            <Style x:Key="DescriptionInputTextBox" TargetType="TextBox">
                <Setter Property="TextWrapping" Value="Wrap"/>
                <Setter Property="FontSize" Value="11"/>
                <Setter Property="Background" Value="#eeeeee"/>
                <Setter Property="BorderBrush" Value="#eeeeee"/>
                <Setter Property="FontFamily" Value="Shabnam FD"/>
                <Setter Property="FontWeight" Value="Medium"/>
                <Setter Property="Padding" Value="5,4,0,0"/>
            </Style>

            <!--DescriptionInputTextBox-->

            <!--Personalize CheckBox-->
            <Style x:Key="PersonalizeCheckBoxRectangle" TargetType="Rectangle">
                <Setter Property="Width" Value="25"/>
                <Setter Property="Height" Value="25"/>
                <Setter Property="Fill" Value="#F9FAFB"/>
                <Setter Property="Cursor" Value="Hand"/>
            </Style>
            <Style x:Key="PersonalizeCheckBoxBorder" TargetType="Border">
                <Setter Property="Width" Value="25"/>
                <Setter Property="Height" Value="25"/>
                <Setter Property="BorderBrush" Value="#00EFA9"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="CornerRadius" Value="8"/>
                <Setter Property="Cursor" Value="Hand"/>
            </Style>
            <Style x:Key="PersonalizeCheckBoxImage" TargetType="Image">
                <Setter Property="Width" Value="30"/>
                <Setter Property="HorizontalAlignment" Value="Center"/>
                <Setter Property="Visibility" Value="Hidden"/>
                <Setter Property="Source" Value="/Images/IsChecked.png"/>
                <Setter Property="Cursor" Value="Hand"/>
            </Style>
            <!--Personalize CheckBox-->

            <!--Small Personalize CheckBox-->
            <Style x:Key="SmallPersonalizeCheckBoxRectangle" TargetType="Rectangle">
                <Setter Property="Width" Value="25"/>
                <Setter Property="Height" Value="25"/>
                <Setter Property="Fill" Value="#F9FAFB"/>
                <Setter Property="Cursor" Value="Hand"/>
            </Style>
            <Style x:Key="SmallPersonalizeCheckBoxBorder" TargetType="Border">
                <Setter Property="Width" Value="25"/>
                <Setter Property="Height" Value="25"/>
                <Setter Property="BorderBrush" Value="#00EFA9"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="CornerRadius" Value="8"/>
                <Setter Property="Cursor" Value="Hand"/>
            </Style>
            <Style x:Key="SmallPersonalizeCheckBoxImage" TargetType="Image">
                <Setter Property="Width" Value="30"/>
                <Setter Property="HorizontalAlignment" Value="Center"/>
                <Setter Property="Visibility" Value="Hidden"/>
                <Setter Property="Source" Value="/Images/IsChecked.png"/>
                <Setter Property="Cursor" Value="Hand"/>
            </Style>

            <!--Small Personalize CheckBox-->

            <!--Button-->
            <Style x:Key="ButtonBorder" TargetType="Border">
                <Setter Property="BorderBrush" Value="#4A8FE7"/>
                <Setter Property="BorderThickness" Value="2"/>
                <Setter Property="CornerRadius" Value="5"/>

            </Style>
            <Style x:Key="Button" TargetType="Button">
                <Setter Property="Width" Value="170"/>
                <Setter Property="Height" Value="30"/>
                <Setter Property="BorderBrush" Value="#4A8FE7"/>
                <Setter Property="Background" Value="#4A8FE7"/>
                <Setter Property="Foreground" Value="#F9FAFB"/>
                <Setter Property="FontFamily" Value="Shabnam FD"/>
            </Style>
            <!--Button-->

            <!--ComboBox-->
            <Style x:Key="ComboBox" TargetType="ComboBox">
                <Setter Property="BorderThickness" Value="0"/>
                <Setter Property="Background" Value="#eeeeee"/>
                <Setter Property="FontFamily" Value="Shabnam FD"/>
                <Setter Property="FontSize" Value="14"/>
            </Style>
            <!--ComboBox-->

            <!--GroupBox-->
            <Style x:Key="GroupBox" TargetType="GroupBox">
                <Setter Property="Background" Value="#F9FAFB"/>
                <Setter Property="BorderBrush" Value="#F9FAFB"/>
                <Setter Property="FontFamily" Value="Shabnam FD"/>
                <Setter Property="Foreground" Value="#4A8FE7"/>
            </Style>
            <!--GroupBox-->

            <!--DateGrid-->
            <Style x:Key="DataGrid" TargetType="DataGrid">
                <Setter Property="Background" Value="#F9FAFB"/>
                <Setter Property="BorderBrush" Value="#F9FAFB"/>
                <Setter Property="FontFamily" Value="Shabnam FD"/>
                <Setter Property="SelectionMode" Value="Single"/>
            </Style>
            <Style x:Key="DataGridBorder" TargetType="Border">
                <Setter Property="BorderBrush" Value="#F9FAFB"/>
                <Setter Property="BorderThickness" Value="3"/>
                <Setter Property="CornerRadius" Value="5"/>
            </Style>
            <!--DateGrid-->

            <!--BackToHome-->
            <Style x:Key="BackToHomeImage" TargetType="Image">
                <Setter Property="Height" Value="40"/>
                <Setter Property="Source" Value="/Images/Home.png"/>
                <Setter Property="ToolTip" Value="بازگشت به خانه"/>
                <Setter Property="Cursor" Value="Hand"/>
                <Setter Property="Grid.Column" Value="11"/>
                <Setter Property="Grid.Row" Value="11"/>
                <Setter Property="Margin" Value="50,0,0,0"/>
            </Style>

            <!--BackToHome-->

            <!--ListBox-->
            <Style x:Key="ListBoxBorder" TargetType="Border">
                <Setter Property="Width" Value="210"/>
                <Setter Property="Height" Value="140"/>
                <Setter Property="BorderThickness" Value="2"/>
                <Setter Property="BorderBrush" Value="#eeeeee"/>
                <Setter Property="CornerRadius" Value="5"/>
            </Style>
            <Style x:Key="ListBox" TargetType="ListBox">
                <Setter Property="BorderThickness" Value="2"/>
                <Setter Property="BorderBrush" Value="#eeeeee"/>
                <Setter Property="Background" Value="#eeeeee"/>
                <Setter Property="FontFamily" Value="Shabnam FD"/>
                <Setter Property="FontSize" Value="14"/>
            </Style>

            <!--ListBox-->

            <!--PersianDatePicker-->
            <!--PersianDatePicker-->

            <!--RadioButton-->
            <Style x:Key="RadioButton" TargetType="RadioButton">
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="BorderBrush" Value="#4A8FE7"/>
                <Setter Property="Background" Value="#eeeeee"/>
                <Setter Property="FontFamily" Value="Shabnam FD"/>

            </Style>
            <!--RadioButton-->

            <!--MenuItem-->
            <Style x:Key="MenuItem" TargetType="MenuItem">
                <Setter Property="HorizontalAlignment" Value="Center"/>
                <Setter Property="VerticalAlignment" Value="Center"/>
                <Setter Property="FontFamily" Value="Shabnam FD"/>
                <Setter Property="Width" Value="200"/>

            </Style>
            <!--MenuItem-->

            <!--ContextMenu-->
            <Style x:Key="ContextMenu" TargetType="ContextMenu">
                <Setter Property="FontFamily" Value="Shabnam FD"/>
                <Setter Property="Width" Value="200"/>
            </Style>
            <!--ContextMenu-->

        </ResourceDictionary>

    </Application.Resources>
</Application>
