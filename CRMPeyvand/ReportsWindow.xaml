<Window x:Class="CRMPeyvand.ReportsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:hc="https://handyorg.github.io/handycontrol"
        xmlns:lvc="clr-namespace:LiveCharts.Wpf;assembly=LiveCharts.Wpf"
        xmlns:local="clr-namespace:CRMPeyvand"
        mc:Ignorable="d"
        ResizeMode="NoResize"
        WindowStyle="None"
        WindowStartupLocation="CenterScreen"
        Background="Transparent"
        AllowsTransparency="True"
        FlowDirection="RightToLeft"
        Title="گزارشات و نمودارها" Height="730" Width="1300"
        Loaded="Window_Loaded" PreviewKeyDown="Window_PreviewKeyDown">

    <Window.Resources>
        <Style x:Key="ChartTypeButton" TargetType="Button">
            <Setter Property="Background" Value="#FFFFFF"/>
            <Setter Property="BorderBrush" Value="#E2E8F0"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Foreground" Value="#1E293B"/>
            <Setter Property="FontFamily" Value="Shabnam FD"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Padding" Value="14,6"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="8">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#EFF6FF"/>
                                <Setter TargetName="border" Property="BorderBrush" Value="#3B82F6"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ActionReportButton" TargetType="Button">
            <Setter Property="Background" Value="#4A8FE7"/>
            <Setter Property="BorderBrush" Value="#3B82F6"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="FontFamily" Value="Shabnam FD"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Height" Value="38"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="btnBorder" Background="{TemplateBinding Background}" CornerRadius="8">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="btnBorder" Property="Background" Value="#2563EB"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Margin="10">
        <!-- Main Background Card -->
        <Border Background="#F9FAFB" BorderBrush="#E2E8F0" BorderThickness="2" CornerRadius="16">
            <Border.Effect>
                <DropShadowEffect BlurRadius="25" Color="#94A3B8" Opacity="0.3" ShadowDepth="4"/>
            </Border.Effect>
        </Border>

        <Grid Margin="18">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="7.5*"/>
                <ColumnDefinition Width="4.5*"/>
            </Grid.ColumnDefinitions>

            <!-- LEFT COLUMN: Chart & Visualizations -->
            <Grid Grid.Column="0" Margin="0,0,15,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Chart Type Selector Header -->
                <Border Grid.Row="0" Background="#FFFFFF" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="10" Padding="12,8" Margin="0,0,0,12">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="📊 تحلیل و نمودارهای آماری" FontFamily="Shabnam FD" FontWeight="Bold" FontSize="16" Foreground="#1E3A8A" VerticalAlignment="Center"/>
                        </StackPanel>

                        <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Left" Margin="20,0,0,0">
                            <Button x:Name="btnColumnChart" Style="{StaticResource ChartTypeButton}" Content="📊 نمودار ستونی" Margin="4,0" Click="btnColumnChart_Click"/>
                            <Button x:Name="btnLineChart" Style="{StaticResource ChartTypeButton}" Content="📈 نمودار خطی" Margin="4,0" Click="btnLineChart_Click"/>
                            <Button x:Name="btnPointChart" Style="{StaticResource ChartTypeButton}" Content="🔘 نمودار نقطه‌ای" Margin="4,0" Click="btnPointChart_Click"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- LiveChart Surface -->
                <Border Grid.Row="1" Background="#FFFFFF" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="12" Padding="15">
                    <Grid>
                        <lvc:CartesianChart x:Name="MainChart" LegendLocation="Top" FontFamily="Shabnam FD" FontSize="12">
                            <lvc:CartesianChart.AxisX>
                                <lvc:Axis x:Name="AxisX" Title="کاربران / تاریخ" FontFamily="Shabnam FD" FontSize="12" Labels="{Binding XLabels}"/>
                            </lvc:CartesianChart.AxisX>
                            <lvc:CartesianChart.AxisY>
                                <lvc:Axis x:Name="AxisY" Title="تعداد / مبلغ" FontFamily="Shabnam FD" FontSize="12" MinValue="0"/>
                            </lvc:CartesianChart.AxisY>
                        </lvc:CartesianChart>

                        <!-- Empty state placeholder if no chart data -->
                        <TextBlock x:Name="txtEmptyChart" Text="برای مشاهده نمودار، گزینه مورد نظر را در بخش 'گزارش بر اساس تاریخ' انتخاب کرده و دکمه 'نمایش در نمودار' را بزنید."
                                   FontFamily="Shabnam FD" FontSize="14" Foreground="#94A3B8"
                                   HorizontalAlignment="Center" VerticalAlignment="Center" TextWrapping="Wrap" TextAlignment="Center"
                                   Visibility="Collapsed"/>
                    </Grid>
                </Border>

                <!-- Bottom Back / Close Bar -->
                <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
                    <Button Style="{StaticResource ActionReportButton}" Background="#64748B" Width="140" Click="btnBack_Click">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="بازگشت" FontFamily="Shabnam FD" FontWeight="Bold" Foreground="#FFFFFF" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>

            <!-- RIGHT COLUMN: Report Controls & Options -->
            <Grid Grid.Column="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- GroupBox 1: General PDF Reports -->
                <GroupBox Grid.Row="0" Header="🖨️ گزارش‌های چاپی و جامع" Style="{StaticResource GroupBox}" Margin="0,0,0,12">
                    <Border Background="#FFFFFF" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="10" Padding="14">
                        <StackPanel>
                            <RadioButton x:Name="rbPrintCustomer" Content="مشتریان ثبت‌نام شده" FontFamily="Shabnam FD" FontSize="13" Margin="0,6" IsChecked="True"/>
                            <RadioButton x:Name="rbPrintActivities" Content="تمام فعالیت‌های ثبت شده" FontFamily="Shabnam FD" FontSize="13" Margin="0,6"/>
                            <RadioButton x:Name="rbPrintThisWeek" Content="لیست فروش هفت روز گذشته" FontFamily="Shabnam FD" FontSize="13" Margin="0,6"/>
                            <RadioButton x:Name="rbPrintThisMonth" Content="لیست فروش ماه گذشته (۳۰ روز گذشته)" FontFamily="Shabnam FD" FontSize="13" Margin="0,6"/>
                            <RadioButton x:Name="rbPrintThisYear" Content="لیست فروش سال گذشته (۳۶۵ روز گذشته)" FontFamily="Shabnam FD" FontSize="13" Margin="0,6"/>
                            <RadioButton x:Name="rbPrintProducts" Content="موجودی محصولات و ارزش انبار" FontFamily="Shabnam FD" FontSize="13" Margin="0,6"/>
                            <RadioButton x:Name="rbPrintCustomerBalances" Content="مانده حساب مشتریان" FontFamily="Shabnam FD" FontSize="13" Margin="0,6"/>

                            <Button Style="{StaticResource ActionReportButton}" Content="🖨️ تولید و دریافت PDF" Margin="0,12,0,4" Click="btnPrintGeneralReport_Click"/>
                        </StackPanel>
                    </Border>
                </GroupBox>

                <!-- GroupBox 2: Date-Filtered Reports & Analytics -->
                <GroupBox Grid.Row="1" Header="📅 گزارش و نمودار بر اساس تاریخ" Style="{StaticResource GroupBox}">
                    <Border Background="#FFFFFF" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="10" Padding="14">
                        <StackPanel>
                            <!-- Date Range Pickers -->
                            <Grid Margin="0,4,0,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0" Margin="0,0,6,0">
                                    <Label Content="از تاریخ:" FontFamily="Shabnam FD" FontSize="12" FontWeight="SemiBold" Foreground="#475569" Padding="0,0,0,4"/>
                                    <hc:PersianDatePicker x:Name="dpStart" FontFamily="Shabnam FD" FontWeight="Bold" Height="32"/>
                                </StackPanel>

                                <StackPanel Grid.Column="1" Margin="6,0,0,0">
                                    <Label Content="تا تاریخ:" FontFamily="Shabnam FD" FontSize="12" FontWeight="SemiBold" Foreground="#475569" Padding="0,0,0,4"/>
                                    <hc:PersianDatePicker x:Name="dpEnd" FontFamily="Shabnam FD" FontWeight="Bold" Height="32"/>
                                </StackPanel>
                            </Grid>

                            <Separator Background="#F1F5F9" Margin="0,6,0,8"/>

                            <!-- Filter Target Options -->
                            <RadioButton x:Name="rbPrintInvoicesD" Content="فروش هر کاربر در بازه انتخابی" FontFamily="Shabnam FD" FontSize="13" Margin="0,6" IsChecked="True"/>
                            <RadioButton x:Name="rbPrintActivitiesD" Content="فعالیت‌های هر کاربر در بازه انتخابی" FontFamily="Shabnam FD" FontSize="13" Margin="0,6"/>
                            <RadioButton x:Name="rbPrintCustomerD" Content="مشتریان ثبت‌نام شده در بازه انتخابی" FontFamily="Shabnam FD" FontSize="13" Margin="0,6"/>

                            <!-- Action Buttons -->
                            <Grid Margin="0,14,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <Button Grid.Column="0" Style="{StaticResource ActionReportButton}" Background="#0D9488" Content="📊 نمایش در نمودار" Margin="0,0,5,0" Click="btnDisplayChart_Click"/>
                                <Button Grid.Column="1" Style="{StaticResource ActionReportButton}" Content="🖨️ دریافت PDF" Margin="5,0,0,0" Click="btnPrintFilteredReport_Click"/>
                            </Grid>
                        </StackPanel>
                    </Border>
                </GroupBox>
            </Grid>
        </Grid>
    </Grid>
</Window>
