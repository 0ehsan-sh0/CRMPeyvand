<Window
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:CRMPeyvand"
        xmlns:hc="https://handyorg.github.io/handycontrol" x:Class="CRMPeyvand.OffCodeForm"
        mc:Ignorable="d"
                ResizeMode="NoResize"
        WindowStyle="None"
        WindowStartupLocation="CenterScreen"
        Background="Transparent"
        AllowsTransparency="True"
        FlowDirection="RightToLeft"

        Title="ReportForm" Height="600" Width="900" Loaded="Window_Loaded" PreviewKeyDown="Window_PreviewKeyDown">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition/>
            <ColumnDefinition/>
            <ColumnDefinition/>
            <ColumnDefinition/>
            <ColumnDefinition/>
            <ColumnDefinition/>
            <ColumnDefinition/>
            <ColumnDefinition/>
            <ColumnDefinition/>
            <ColumnDefinition/>
            <ColumnDefinition/>
            <ColumnDefinition/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition/>
            <RowDefinition Height="50"/>
            <RowDefinition/>
            <RowDefinition/>
            <RowDefinition/>
            <RowDefinition/>
            <RowDefinition/>
            <RowDefinition/>
            <RowDefinition/>
            <RowDefinition/>
            <RowDefinition/>
            <RowDefinition/>
        </Grid.RowDefinitions>
        <!--Background-->
        <Border Grid.ColumnSpan="12" Grid.RowSpan="12" BorderThickness="5" BorderBrush="#eeeeee" CornerRadius="10">
            <Rectangle Fill="#eeeeee"/>
        </Border>
        <!--Background-->

        <!--منوی تغییرات-->
        <GroupBox Style="{StaticResource GroupBox}" Header="ایجاد کد تخفیف" Grid.ColumnSpan="12" Grid.RowSpan="5" Margin="10,5,10,34" />
        <Label Style="{StaticResource TextBoxLabel}" Grid.Column="0" Content="کد تخفیف :" HorizontalAlignment="Left" Grid.RowSpan="2" VerticalAlignment="Center" Margin="18,0,0,0" Grid.ColumnSpan="2" Width="75"/>
        <Border Style="{StaticResource InputTextBoxBorder}" HorizontalAlignment="Left" Grid.RowSpan="2" VerticalAlignment="Top" Grid.Column="1" Grid.ColumnSpan="5" Margin="31,36,0,0">
            <TextBox Style="{StaticResource InputTextBox}" x:Name="txtCode" TabIndex="0"/>
        </Border>

        <Rectangle Style="{StaticResource PersonalizeCheckBoxRectangle}" Height="20" Width="20" Margin="20,30,35,0" Grid.Row="1" MouseLeftButtonDown="IsChecked_MouseLeftButtonDown" ToolTip="اگر میخواهید تخفیف را به صورت تومان وارد کنید این فیلد را خالی بگذارید"/>
        <Border Style="{StaticResource PersonalizeCheckBoxBorder}" CornerRadius="6" Width="20" Height="20" x:Name="IsChecked" Grid.Row="1" Margin="20,30,35,0" MouseLeftButtonDown="IsChecked_MouseLeftButtonDown" MouseEnter="IsChecked_MouseEnter" MouseLeave="IsChecked_MouseLeave" ToolTip="اگر میخواهید تخفیف را به صورت تومان وارد کنید این فیلد را خالی بگذارید">
            <Image Style="{StaticResource PersonalizeCheckBoxImage}" x:Name="IsCheckedImage"/>
        </Border>
        <Label Style="{StaticResource TextBoxLabel}" Content="وارد کردن تخفیف به صورت درصد" HorizontalAlignment="Left" Grid.Row="1" Grid.RowSpan="2" VerticalAlignment="Top" Margin="45,26,0,0" Grid.ColumnSpan="4" ToolTip="اگر میخواهید تخفیف را به صورت تومان وارد کنید این فیلد را خالی بگذارید" Width="185"/>

        <hc:NumericUpDown x:Name="nudPercent" FontFamily="Shabnam FD" HorizontalAlignment="Left" Height="30" Minimum="0" Maximum="100" Margin="20,10,0,10" Width="204" Grid.ColumnSpan="3" Grid.Row="2" TabIndex="1"/>

        <Label Style="{StaticResource TextBoxLabel}" Grid.Column="0" Content="مبلغ تخفیف :" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="18,9,0,0" Grid.Row="3" Grid.ColumnSpan="2" Width="86"/>
        <Border Style="{StaticResource InputTextBoxBorder}" HorizontalAlignment="Left" VerticalAlignment="Center" Grid.Column="1" Grid.ColumnSpan="5" Grid.Row="3" Margin="34,0,0,0">
            <TextBox Style="{StaticResource InputTextBox}" x:Name="txtPrice" TabIndex="2" TextChanged="txtPrice_TextChanged"/>
        </Border>

        <Label Style="{StaticResource TextBoxLabel}" Grid.Column="5" Content="تاریخ انقضا (اختیاری) :" Grid.RowSpan="2" VerticalAlignment="Top" Margin="65,25,34,0" Grid.ColumnSpan="3" Grid.Row="1"/>
        <hc:PersianDatePicker x:Name="DatePicker" FontFamily="Shabnam FD" FontWeight="Bold" Grid.Column="9" Grid.ColumnSpan="3" Margin="21,23,39,47" TabIndex="4" Grid.Row="1" RenderTransformOrigin="1.149,0.443" Grid.RowSpan="2"/>

        <Label Style="{StaticResource TextBoxLabel}" Grid.Column="5" Content="محدودیت استفاده برای هر مشتری (اختیاری) :" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="65,37,0,0" Grid.RowSpan="2" Grid.ColumnSpan="5" Width="251"/>
        <Border Style="{StaticResource InputTextBoxBorder}" HorizontalAlignment="Left" VerticalAlignment="Top" Grid.Column="9" Margin="21,36,0,0" Grid.RowSpan="2" Width="165" Grid.ColumnSpan="3">
            <TextBox Style="{StaticResource InputTextBox}" x:Name="txtLimit" TabIndex="3" TextChanged="txtPrice_TextChanged"/>
        </Border>

        <Border Style="{StaticResource ButtonBorder}" x:Name="btnAddBorder" Grid.Column="5" Grid.ColumnSpan="7" HorizontalAlignment="Left" Grid.Row="3" VerticalAlignment="Center" Margin="70,0,0,0" Width="416" >
            <Button Style="{StaticResource Button}" x:Name="btnAdd" Content="ثبت کد تخفیف" TabIndex="5" Click="btnAdd_Click" Width="416"/>
        </Border>

        <!--منوی تغییرات-->

        <!--جستجوی تخفیف-->
        <GroupBox Style="{StaticResource GroupBox}" Header="جستجو کد تخفیف" Grid.Row="4" Grid.RowSpan="2" Grid.ColumnSpan="12" Margin="10,25,10,0"/>
        <Border Style="{StaticResource InputTextBoxBorder}" Grid.Column="0" Grid.ColumnSpan="12"  HorizontalAlignment="Left" VerticalAlignment="Center" Grid.Row="5" Margin="20,0,0,0" Width="862">
            <TextBox Style="{StaticResource InputTextBox}" x:Name="txtSearch" TabIndex="5" TextChanged="txtSearch_TextChanged" ToolTip="جستجو بر اساس کد"/>
        </Border>
        <Image Source="/Images/Search.png" Grid.Column="11" Grid.Row="5" Height="25" Margin="0,12,0,12"/>
        <!--جستجوی تخفیف-->

        <!--نمایش کد تخفیف-->
        <Border Style="{StaticResource DataGridBorder}" Grid.Column="0" Grid.ColumnSpan="12" Grid.Row="6" Grid.RowSpan="5"  Margin="10,10,10,0">

            <DataGrid Style="{StaticResource DataGrid}" x:Name="dgvOffCodes" ContextMenuOpening="dgvOffCodes_ContextMenuOpening" Grid.ColumnSpan="12" Margin="0,0,-1,0" Grid.RowSpan="5">
                <DataGrid.ContextMenu>
                    <ContextMenu Style="{StaticResource ContextMenu}">
                        <MenuItem Style="{StaticResource MenuItem}" x:Name="miEdit" Header="ویرایش کد تخفیف" Click="miEdit_Click">
                            <MenuItem.Icon>
                                <Image Source="/Images/Edit.png"/>
                            </MenuItem.Icon>
                        </MenuItem>
                        <MenuItem Style="{StaticResource MenuItem}" x:Name="miDelete" Header="حذف کد تخفیف" Click="miDelete_Click">
                            <MenuItem.Icon>
                                <Image Source="/Images/Delete.png"/>
                            </MenuItem.Icon>
                        </MenuItem>
                        <MenuItem Style="{StaticResource MenuItem}" x:Name="miCopy" Header="کپی کد تخفیف" Click="miCopy_Click" ToolTip="پس از کپی میتوانید آنرا به همراه پیغام برای مشتریان خود ارسال کنید">
                            <MenuItem.Icon>
                                <Image Source="/Images/Copy.png"/>
                            </MenuItem.Icon>
                        </MenuItem>
                    </ContextMenu>
                </DataGrid.ContextMenu>

            </DataGrid>
        </Border>
        <!--نمایش کد تخفیف-->

        <!--منوی پایین-->
        <Image Style="{StaticResource BackToHomeImage}" x:Name="BackToHome" MouseLeftButtonDown="BackToHome_MouseLeftButtonDown" Grid.Column="11" Margin="15,44,10,6" Grid.Row="10" Width="40" Height="40" Grid.RowSpan="2"/>
        <Label Style="{StaticResource TextBoxLabel}" FontSize="14" Grid.Column="0" Grid.ColumnSpan="3" Content="کد تخفیف های ثبت شده :" HorizontalAlignment="Left" Grid.Row="11" VerticalAlignment="Top" Margin="10,6,0,0" Grid.RowSpan="1" Width="162" />
        <Label Style="{StaticResource TextBoxLabel}" x:Name="lblCount" FontSize="20" FontWeight="Bold" Grid.Column="2" Content="0" HorizontalAlignment="Left" Grid.Row="11" VerticalAlignment="Top" Margin="22,3,0,0" Grid.ColumnSpan="3" Width="203"/>

        <!--منوی پایین-->

    </Grid>
</Window>
