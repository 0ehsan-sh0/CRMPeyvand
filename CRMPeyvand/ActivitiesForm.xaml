<Window x:Class="CRMPeyvand.ActivitiesForm"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:hc="https://handyorg.github.io/handycontrol"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:CRMPeyvand"
        mc:Ignorable="d"
        ResizeMode="NoResize"
        WindowStyle="None"
        WindowStartupLocation="CenterScreen"
        Background="Transparent"
        AllowsTransparency="True"
        FlowDirection="RightToLeft"

        Title="ActivitiesForm" Height="600" Width="1260" Loaded="Window_Loaded" PreviewKeyDown="Window_PreviewKeyDown">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition/>
            <ColumnDefinition/>
            <ColumnDefinition/>
            <ColumnDefinition/>
            <ColumnDefinition/>
            <ColumnDefinition/>
            <ColumnDefinition/>
            <ColumnDefinition/>
            <ColumnDefinition/>
            <ColumnDefinition/>
            <ColumnDefinition/>
            <ColumnDefinition/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition/>
            <RowDefinition Height="50"/>
            <RowDefinition Height="50"/>
            <RowDefinition/>
            <RowDefinition/>
            <RowDefinition/>
            <RowDefinition/>
            <RowDefinition/>
            <RowDefinition/>
            <RowDefinition/>
            <RowDefinition/>
            <RowDefinition/>
        </Grid.RowDefinitions>
        <!--Background-->
        <Border Grid.ColumnSpan="12" Grid.RowSpan="12" BorderThickness="5" BorderBrush="#eeeeee" CornerRadius="10">
            <Rectangle Fill="#eeeeee"/>
        </Border>
        <!--Background-->

        <!--ایجاد فعالیت-->
        <GroupBox Style="{StaticResource GroupBox}" Header="ایجاد فعالیت" Grid.ColumnSpan="12" Grid.RowSpan="5" Margin="10,5,10,15" />
        <Label Style="{StaticResource TextBoxLabel}"  Content="جستجو مشتری بر اساس شماره تلفن :" HorizontalAlignment="Right" Grid.Row="0" Grid.RowSpan="2" Grid.ColumnSpan="3" Grid.Column="0" VerticalAlignment="Top" Margin="0,37,84,0"/>
        <Border Style="{StaticResource InputTextBoxBorder}" HorizontalAlignment="Left" Grid.Row="0" Grid.RowSpan="2" VerticalAlignment="Center" Grid.Column="2" Grid.ColumnSpan="4" Margin="27,0,0,0">
            <hc:ComboBox Style="{StaticResource ComboBox}" IsEditable="True" x:Name="txtCustomer" Padding="0,5,0,0" SelectionChanged="txtCustomer_SelectionChanged" TabIndex="0"/>
        </Border>
        <Label Style="{StaticResource TextBoxLabel}" Grid.Column="0" Content="جستجو کاربر بر اساس نام کاربری :" HorizontalAlignment="Left" Grid.Row="1" Grid.RowSpan="2" VerticalAlignment="Top" Margin="20,33,0,0" Grid.ColumnSpan="2"/>
        <Border Style="{StaticResource InputTextBoxBorder}" HorizontalAlignment="Left" Grid.Row="1" Grid.RowSpan="2" VerticalAlignment="Top" Grid.Column="2" Grid.ColumnSpan="4" Margin="27,33,0,0">
            <hc:ComboBox Style="{StaticResource ComboBox}" IsEditable="True" x:Name="txtUser" Padding="0,5,0,0" SelectionChanged="txtUser_SelectionChanged" TabIndex="1"/>
        </Border>

        <Label Style="{StaticResource TextBoxLabel}" Grid.Column="0" Content="دسته بندی فعالیت :" HorizontalAlignment="Right" Grid.Row="2" Grid.RowSpan="2" VerticalAlignment="Top" Margin="0,34,70,0" Grid.ColumnSpan="2"/>
        <Border Style="{StaticResource InputTextBoxBorder}" HorizontalAlignment="Left" Grid.Row="2" Grid.RowSpan="2" VerticalAlignment="Top" Grid.Column="2" Grid.ColumnSpan="4" Margin="27,32,0,0">
            <hc:ComboBox Style="{StaticResource ComboBox}" IsEditable="True" x:Name="txtCategory" Padding="0,5,0,0" SelectionChanged="txtCategory_SelectionChanged" TabIndex="2"/>
        </Border>


        <Label Style="{StaticResource TextBoxLabel}" Grid.Column="0" Content="موضوع فعالیت :" HorizontalAlignment="Right" Grid.Row="3" Grid.RowSpan="2" VerticalAlignment="Top" Margin="0,33,92,0" Grid.ColumnSpan="2"/>
        <Border Style="{StaticResource InputTextBoxBorder}" HorizontalAlignment="Left" Grid.Row="3" Grid.RowSpan="2" VerticalAlignment="Center" Grid.Column="2" Grid.ColumnSpan="4" Margin="27,0,0,0">
            <TextBox Style="{StaticResource InputTextBox}" x:Name="txtActivityTopic" TabIndex="3"/>
        </Border>

        <Border Style="{StaticResource InputTextBoxBorder}" Height="128" Grid.Column="6" Grid.RowSpan="4" VerticalAlignment="Top" Grid.ColumnSpan="6" Margin="0,37,20,0" Width="NaN">
            <TextBox Style="{StaticResource DescriptionInputTextBox}" Text="توضیحات" x:Name="txtActivityInfo" TabIndex="4"/>
        </Border>
        <!--تنظیم یاد آور-->
        <hc:PersianDatePicker x:Name="DatePicker" FontFamily="Shabnam FD" FontWeight="Bold" Grid.Column="8" Grid.ColumnSpan="2" Grid.Row="3" Grid.RowSpan="2" Margin="14,35,21,35" TabIndex="5"/>
        <Rectangle Style="{StaticResource PersonalizeCheckBoxRectangle}" Height="20" Width="20" Margin="10,38,70,37" Grid.Row="3"  Grid.RowSpan="2" Grid.Column="6" MouseLeftButtonDown="IsChecked4_MouseLeftButtonDown"/>
        <Border Style="{StaticResource PersonalizeCheckBoxBorder}" CornerRadius="6" Width="20" Height="20" x:Name="IsChecked4" Grid.Row="3" Margin="10,38,70,37" Grid.RowSpan="2" Grid.Column="6" MouseLeftButtonDown="IsChecked4_MouseLeftButtonDown" MouseEnter="IsChecked_MouseEnter" MouseLeave="IsChecked_MouseLeave">
            <Image Style="{StaticResource PersonalizeCheckBoxImage}" x:Name="IsChecked4Image"/>
        </Border>
        <Label Style="{StaticResource TextBoxLabel}" Grid.Column="6" Content="برای فعالیت یادآور تنظیم کن." HorizontalAlignment="Left" Grid.Row="3" Grid.RowSpan="2" VerticalAlignment="Center" Margin="36,0,0,0" Grid.ColumnSpan="2"/>

        <!--تنظیم یاد آور-->

        <!--btnAdd-->
        <Border Style="{StaticResource ButtonBorder}" x:Name="btnAddBorder" Grid.Column="10" Grid.ColumnSpan="2" HorizontalAlignment="Left" Grid.Row="3" Grid.RowSpan="2" VerticalAlignment="Center" Margin="15,0,0,0" >
            <Button Style="{StaticResource Button}" x:Name="btnAdd" Content="ثبت یادآور" TabIndex="6" Click="btnAdd_Click" ToolTip="میانبر Enter"/>
        </Border>
        <!--btnAdd-->

        <!--ایجاد یادآور-->


        <!--جستجوی مشتری-->
        <GroupBox Style="{StaticResource GroupBox}" Header="جستجوی بین فعالیت ها" Grid.Row="5" Grid.RowSpan="2" Grid.ColumnSpan="12" Margin="10,0,10,25"/>
        <Border Style="{StaticResource InputTextBoxBorder}" Grid.Column="0" Grid.ColumnSpan="12"  HorizontalAlignment="Left" VerticalAlignment="Center" Grid.Row="5" Grid.RowSpan="2" Margin="30,0,0,0" Width="1200">
            <TextBox Style="{StaticResource InputTextBox}" x:Name="txtSearchActivities" TabIndex="7" TextChanged="txtSearchActivities_TextChanged" ToolTip="میتوانید بر اساس عنوان توضیحات و دسته بندی فعالیت و یا بر اساس نام کاربر جستجو کنید"/>
        </Border>
        <Image Source="/Images/Search.png" Grid.Column="11" Grid.Row="5" Grid.RowSpan="2" Height="25"/>
        <!--جستجوی مشتری-->

        <!--نمایش فعالیت ها-->
        <Border Style="{StaticResource DataGridBorder}" Grid.Column="0" Grid.ColumnSpan="12" Grid.Row="7" Grid.RowSpan="4"  Margin="10,0,10,0">
            <DataGrid Style="{StaticResource DataGrid}" x:Name="dgvActivities" ContextMenuOpening="dgvActivities_ContextMenuOpening">
                <DataGrid.ContextMenu>
                    <ContextMenu Style="{StaticResource ContextMenu}">
                        <MenuItem Style="{StaticResource MenuItem}" x:Name="miEdit" Header="ویرایش فعالیت" Click="miEdit_Click">
                            <MenuItem.Icon>
                                <Image Source="/Images/Edit.png"/>
                            </MenuItem.Icon>
                        </MenuItem>
                        <MenuItem Style="{StaticResource MenuItem}" x:Name="miDelete" Header="حذف فعالیت" Click="miDelete_Click">
                            <MenuItem.Icon>
                                <Image Source="/Images/Delete.png"/>
                            </MenuItem.Icon>
                        </MenuItem>
                    </ContextMenu>
                </DataGrid.ContextMenu>

            </DataGrid>
        </Border>
        <!--نمایش فعالیت ها-->


        <!--منوی پایین-->
        <Image Style="{StaticResource BackToHomeImage}" x:Name="BackToHome" MouseLeftButtonDown="BackToHome_MouseLeftButtonDown"/>
        <Label Style="{StaticResource TextBoxLabel}" FontSize="14" Grid.Column="0" Grid.ColumnSpan="2" Content="تعداد فعالیت های ثبت شده :" HorizontalAlignment="Left" Grid.Row="11" VerticalAlignment="Center" Margin="10,0,0,0" Grid.RowSpan="1" />
        <Label Style="{StaticResource TextBoxLabel}" x:Name="lblCount" FontSize="20" FontWeight="Bold" Grid.Column="1" Grid.ColumnSpan="2" Content="0" HorizontalAlignment="Center" Grid.Row="11" VerticalAlignment="Center" Margin="0,0,0,0"/>
        <!--منوی پایین-->


    </Grid>
</Window>
