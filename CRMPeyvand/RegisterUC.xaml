<UserControl x:Class="CRMPeyvand.RegisterUC"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:hc="https://handyorg.github.io/handycontrol"
             xmlns:local="clr-namespace:CRMPeyvand"
             mc:Ignorable="d" 
             FlowDirection="RightToLeft"
             d:DesignHeight="500" d:DesignWidth="450" FontFamily="Shabnam FD">
    <Grid x:Name="MainGrid">
        <Grid.ColumnDefinitions>
            <ColumnDefinition/>
            <ColumnDefinition/>
            <ColumnDefinition/>
            <ColumnDefinition/>
            <ColumnDefinition/>
            <ColumnDefinition/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition/>
            <RowDefinition/>
            <RowDefinition/>
            <RowDefinition/>
            <RowDefinition/>
            <RowDefinition/>
        </Grid.RowDefinitions>

        <Label Style="{StaticResource TextBoxLabel}" x:Name="lblWelcome" HorizontalAlignment="Center" FontWeight="Bold" FontSize="23" Content="به نرم افزار پیوند خوش آمدید" Foreground="#ffffff" Grid.Column="1" Grid.ColumnSpan="4" Margin="0,0,0,40" Width="294"/>
        <Label Style="{StaticResource TextBoxLabel}" x:Name="lblDetails" HorizontalAlignment="Center" FontWeight="Medium" FontSize="18" Content="برای اولین ورود ثبت نام کنید" Foreground="#ffffff" Grid.Column="1" Grid.ColumnSpan="4" Margin="0,28,0,12" Width="226" Grid.Row="2"/>

        <Image Source="/Images/UserWhite.png" x:Name="img" Grid.Column="1" Grid.ColumnSpan="4" Margin="58,20,58,20" Grid.RowSpan="3" />

        <Border Style="{StaticResource InputTextBoxBorder}" x:Name="BorderName" BorderBrush="White" Grid.ColumnSpan="4" Margin="3,68,3,68" Grid.Row="2" Grid.Column="1" Grid.RowSpan="2">
            <TextBox Style="{StaticResource InputTextBox}" Background="White" x:Name="txtName" Text="نام و نام خانوادگی" Foreground="Gray" GotFocus="TextBox_GotFocus" TabIndex="0" TextChanged="txtName_TextChanged" ToolTip="نام و نام خانوادگی را لطفا فارسی وارد کنید"/>
        </Border>

        <Border Style="{StaticResource InputTextBoxBorder}" x:Name="BorderUserName" BorderBrush="White" Grid.ColumnSpan="4" Margin="3,27,2,26" Grid.Row="3" Grid.Column="1">
            <TextBox Style="{StaticResource InputTextBox}" Background="White" x:Name="txtUserName" Text="نام کاربری" Foreground="Gray" GotFocus="TextBox_GotFocus" TabIndex="1"/>
        </Border>

        <hc:PasswordBox x:Name="txtPass" PasswordChar="*" Foreground="Gray" Password="رمز عبور" GotFocus="txtPass_GotFocus" Margin="73,77,44,71" Grid.Column="2" Grid.Row="3" TabIndex="2" Grid.RowSpan="2" Grid.ColumnSpan="2"/>

        <!--<Border Style="{StaticResource InputTextBoxBorder}" x:Name="borderPass" BorderBrush="White" Grid.ColumnSpan="4" Margin="3,72,2,65" Grid.Row="3" Grid.Column="1" Grid.RowSpan="2">
            <TextBox Style="{StaticResource InputTextBox}" x:Name="txtPass" Background="White" Text="رمز عبور" Foreground="Gray" GotFocus="TextBox_GotFocus" TabIndex="2" ToolTip="رمز باید بیشتر از 8 کاراکتر و کمتر از 32 کاراکتر باشد"/>
        </Border>-->


        <Border Style="{StaticResource InputTextBoxBorder}" x:Name="borderReapeatPass" BorderBrush="White"  Grid.ColumnSpan="4" Margin="3,33,2,21" Grid.Row="4" Grid.Column="1">
            <TextBox Style="{StaticResource InputTextBox}" Background="White" x:Name="txtRepeatPass" Text="تکرار رمز عبور" Foreground="Gray" GotFocus="TextBox_GotFocus" TabIndex="3"/>
        </Border>

        <Border Style="{StaticResource ButtonBorder}" x:Name="btnBorder" BorderBrush="White" HorizontalAlignment="Left" Height="30" Width="149" Grid.ColumnSpan="2" Margin="1,0,0,53" Grid.Column="3" Grid.Row="5">
            <Button Style="{StaticResource Button}" Foreground="Black" FontWeight="Bold" Background="White" x:Name="btnAddUser"  Click="btnAddUser_Click" HorizontalAlignment="Center" VerticalAlignment="Center" Width="149" Content="ثبت نام" TabIndex="4"/>
        </Border>
        <Border x:Name="picBoxUserBorder" Grid.Row="5" VerticalAlignment="Top" HorizontalAlignment="Left" Height="30" Width="32" BorderBrush="#ffffff" BorderThickness="2" CornerRadius="6" Grid.Column="1">
            <Image Source="/Images/UserWhite.png" x:Name="picBoxUser" Stretch="Fill" ToolTip=" برای وارد کردن عکس کاربر کلیک کنید" MouseLeftButtonDown="picBoxUser_MouseLeftButtonDown"/>
        </Border>
        <Label Style="{StaticResource TextBoxLabel}" x:Name="lblImg" HorizontalAlignment="Left" FontWeight="Medium" FontSize="11" Content="انتخاب عکس" Foreground="#ffffff" Grid.Column="1" Margin="32,3,0,52" Width="73" Grid.Row="5" Grid.ColumnSpan="2" MouseLeftButtonDown="picBoxUser_MouseLeftButtonDown"/>
        <Image Source="/Images/UserWhite.png" Visibility="Hidden" x:Name="SourceOfImage" Stretch="Fill" ToolTip=" برای وارد کردن عکس کاربر کلیک کنید" MouseLeftButtonDown="picBoxUser_MouseLeftButtonDown" Grid.Column="2" Grid.ColumnSpan="2" Margin="38,10,37,73" Grid.RowSpan="2" Grid.Row="1"/>

    </Grid>
</UserControl>
