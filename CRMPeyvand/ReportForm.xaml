<Window x:Class="CRMPeyvand.ReportForm"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:CRMPeyvand"
        mc:Ignorable="d"
        ResizeMode="NoResize"
        WindowStyle="None"
        WindowStartupLocation="CenterScreen"
        Background="Transparent"
        AllowsTransparency="True"
        FlowDirection="RightToLeft"
        Title="ReportForm" Height="400" Width="400" Loaded="Window_Loaded" PreviewKeyDown="Window_PreviewKeyDown">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition/>
            <ColumnDefinition/>
            <ColumnDefinition/>
            <ColumnDefinition/>
            <ColumnDefinition/>
            <ColumnDefinition/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition/>
            <RowDefinition/>
            <RowDefinition/>
            <RowDefinition/>
            <RowDefinition/>
            <RowDefinition/>
        </Grid.RowDefinitions>
        <!--Background-->
        <Border Grid.ColumnSpan="6" Grid.RowSpan="6" BorderThickness="5" BorderBrush="#4A8FE7" CornerRadius="10">
            <Rectangle Fill="#4A8FE7"/>
        </Border>
        <!--Background-->

        <!--فرم فعال سازی پنل پیامکی-->
        <Image Source="/Images/Message White.png" Grid.Column="2" Grid.ColumnSpan="2" Margin="0,19,0,85" Grid.RowSpan="3" />
        <Label Style="{StaticResource TextBoxLabel}" x:Name="lblDetails" HorizontalAlignment="Left" FontWeight="Medium" FontSize="20" Content="" Foreground="#ffffff" Grid.Column="1" Grid.ColumnSpan="4" Margin="9,43,0,51" Width="247" Grid.Row="1" Grid.RowSpan="2"/>

        <Border Style="{StaticResource InputTextBoxBorder}" x:Name="BorderName" BorderBrush="White" Grid.ColumnSpan="6" Margin="52,37,53,0" Grid.Row="2">
            <TextBox Style="{StaticResource InputTextBox}" Background="White" x:Name="txtAPI" Text="کلید API" Foreground="Gray" GotFocus="txtLineNumber_GotFocus" TabIndex="0"/>
        </Border>

        <Border Style="{StaticResource InputTextBoxBorder}" x:Name="BorderUserName" BorderBrush="White" Grid.ColumnSpan="6" Margin="52,18,52,19" Grid.Row="3">
            <TextBox Style="{StaticResource InputTextBox}" Background="White" x:Name="txtLineNumber" Text="30006482009053" Foreground="Gray" GotFocus="txtLineNumber_GotFocus" TextChanged="txtLineNumber_TextChanged" TabIndex="1"/>
        </Border>

        <Border Style="{StaticResource ButtonBorder}" x:Name="btnBorder" BorderBrush="White" HorizontalAlignment="Left" Height="30" Width="148" Grid.ColumnSpan="4" Margin="59,0,0,36" Grid.Column="1" Grid.Row="4">
            <Button Style="{StaticResource Button}" Foreground="Black" FontWeight="Bold" Background="White" x:Name="btnAdd"  Click="btnAdd_Click" HorizontalAlignment="Center" VerticalAlignment="Center" Width="149" Content="ثبت اطلاعات" TabIndex="2"/>
        </Border>

        <!--فرم فعال سازی پنل پیامکی-->

        <!--راهنمای فعال سازی-->
        <Image Source="/Images/Info White.png"  Cursor="Hand" MouseLeftButtonDown="Image_MouseLeftButtonDown_1" Margin="15,51,16,57" Grid.Row="4" Grid.Column="1" Grid.RowSpan="2"/>
        <Label Style="{StaticResource TextBoxLabel}" x:Name="lblHelp" HorizontalAlignment="Left" FontWeight="Medium" FontSize="15" Content="راهنمای فعال سازی پنل پیامکی" Foreground="#ffffff" Grid.Column="1" Grid.ColumnSpan="4" Margin="49,47,0,46" Width="197" Grid.Row="4" Cursor="Hand" MouseLeftButtonDown="Image_MouseLeftButtonDown_1" Grid.RowSpan="2"/>
        <!--راهنمای فعال سازی-->

        <!--BackToHome-->
        <Image Source="/Images/Home White.png" Cursor="Hand" MouseLeftButtonDown="Image_MouseLeftButtonDown" Grid.Column="5" Margin="10,10,10,10" Grid.Row="5" RenderTransformOrigin="0.282,0.351"/>
        <!--BackToHome-->
    </Grid>
</Window>
