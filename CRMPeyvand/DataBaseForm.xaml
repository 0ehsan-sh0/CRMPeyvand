<Window x:Class="CRMPeyvand.DataBaseForm"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:CRMPeyvand"
        mc:Ignorable="d"

        ResizeMode="CanResize" MinHeight="640" MinWidth="520"
        WindowStyle="None"
        WindowStartupLocation="CenterScreen"
        Background="Transparent"
        AllowsTransparency="True"
        FlowDirection="RightToLeft"

        Title="DataBaseForm" Height="820" Width="560"
        Loaded="Window_Loaded" PreviewKeyDown="Window_PreviewKeyDown">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="46"/>
        </Grid.RowDefinitions>

        <!--Background-->
        <Border Grid.Column="0" Grid.Row="0" BorderThickness="5" BorderBrush="#eeeeee" CornerRadius="10">
            <Rectangle Fill="#eeeeee"/>
        </Border>
        <!--Background-->

        <ScrollViewer Grid.Column="0" Grid.Row="0" VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled" Padding="8,10,8,4">
            <StackPanel>

                <!-- ===================== وضعیت پایگاه داده ===================== -->
                <Grid Margin="0,0,0,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="26"/>
                        <RowDefinition Height="32"/>
                        <RowDefinition Height="26"/>
                        <RowDefinition Height="32"/>
                        <RowDefinition Height="30"/>
                        <RowDefinition Height="42"/>
                    </Grid.RowDefinitions>

                    <GroupBox Style="{StaticResource GroupBox}" Header="وضعیت پایگاه داده"
                              Grid.ColumnSpan="3" Grid.RowSpan="6" Margin="0,0,0,0"/>

                    <Label Style="{StaticResource TextBoxLabel}" Content="پایگاه داده فعال :"
                           Grid.Column="0" Grid.Row="0" HorizontalAlignment="Right" Margin="0,0,8,0"/>
                    <TextBlock x:Name="lblActiveProvider" Grid.Column="1" Grid.ColumnSpan="2" Grid.Row="0"
                               FontFamily="Shabnam FD" FontSize="12" FontWeight="Bold" Foreground="#0d63f1"
                               HorizontalAlignment="Right" VerticalAlignment="Center" Text="—"/>

                    <Label Style="{StaticResource TextBoxLabel}" Content="محل فایل SQLite :"
                           Grid.Column="0" Grid.Row="2" HorizontalAlignment="Right" Margin="0,0,8,0"/>
                    <Border Style="{StaticResource InputTextBoxBorder}" Grid.Column="1" Grid.ColumnSpan="2" Grid.Row="2" Margin="0,0,8,0">
                        <TextBox Style="{StaticResource InputTextBox}" x:Name="txtSqlitePath"
                                 IsReadOnly="True" BorderThickness="0" Padding="2,4,2,4"
                                 FontFamily="Shabnam FD" FontSize="10" TabIndex="0"/>
                    </Border>

                    <Label Style="{StaticResource TextBoxLabel}" Content="وضعیت فایل :"
                           Grid.Column="0" Grid.Row="3" HorizontalAlignment="Right" Margin="0,0,8,0"/>
                    <TextBlock x:Name="lblSqliteExists" Grid.Column="1" Grid.ColumnSpan="2" Grid.Row="3"
                               FontFamily="Shabnam FD" FontSize="11" HorizontalAlignment="Right"
                               VerticalAlignment="Center" Text="—"/>

                    <Border Style="{StaticResource ButtonBorder}" Grid.Column="0" Grid.ColumnSpan="3" Grid.Row="5"
                            Height="34" Margin="0,6,0,0">
                        <Button Style="{StaticResource Button}" x:Name="btnToggleSqlServer" Height="30"
                                Click="btnToggleSqlServer_Click" TabIndex="1">
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                <Image Source="/Images/Display.png" Width="17" Height="17" Margin="0,0,7,0"/>
                                <TextBlock x:Name="btnToggleSqlServerText" Text="فعال کردن اتصال SQL Server"/>
                            </StackPanel>
                        </Button>
                    </Border>
                </Grid>
                <!-- ===================== وضعیت پایگاه داده ===================== -->

                <!-- ===================== پیکربندی SQL Server ===================== -->
                <Grid Margin="0,0,0,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="120"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="30"/>
                        <RowDefinition Height="34"/>
                        <RowDefinition Height="34"/>
                        <RowDefinition Height="34"/>
                        <RowDefinition Height="34"/>
                        <RowDefinition Height="30"/>
                        <RowDefinition Height="34"/>
                        <RowDefinition Height="34"/>
                        <RowDefinition Height="40"/>
                    </Grid.RowDefinitions>

                    <GroupBox Style="{StaticResource GroupBox}" Header="پیکربندی SQL Server"
                              Grid.ColumnSpan="3" Grid.RowSpan="9" Margin="0,0,0,0"/>

                    <Label Style="{StaticResource TextBoxLabel}" Content="نام سرور :" Grid.Column="0" Grid.Row="1"
                           HorizontalAlignment="Right" Margin="0,0,8,0"/>
                    <Border Style="{StaticResource InputTextBoxBorder}" Grid.Column="1" Grid.ColumnSpan="2" Grid.Row="1" Margin="0,0,8,0">
                        <TextBox Style="{StaticResource InputTextBox}" x:Name="txtServer" TabIndex="2" TextChanged="TextFieldChanged"
                                 ToolTip="نام سرور یا نمونه محلی. برای نمونه پیش‌فرض روی همین رایانه نقطه بنویسید"/>
                    </Border>

                    <Label Style="{StaticResource TextBoxLabel}" Content="نام پایگاه داده :" Grid.Column="0" Grid.Row="2"
                           HorizontalAlignment="Right" Margin="0,0,8,0"/>
                    <Border Style="{StaticResource InputTextBoxBorder}" Grid.Column="1" Grid.ColumnSpan="2" Grid.Row="2" Margin="0,0,8,0">
                        <TextBox Style="{StaticResource InputTextBox}" x:Name="txtDatabase" TabIndex="3" TextChanged="TextFieldChanged"
                                 ToolTip="نام پایگاه داده. در صورت خالی بودن، خود برنامه آن را می سازد"/>
                    </Border>

                    <Label Style="{StaticResource TextBoxLabel}" Content="نام کاربری :" Grid.Column="0" Grid.Row="3"
                           HorizontalAlignment="Right" Margin="0,0,8,0"/>
                    <Border Style="{StaticResource InputTextBoxBorder}" Grid.Column="1" Grid.ColumnSpan="2" Grid.Row="3" Margin="0,0,8,0">
                        <TextBox Style="{StaticResource InputTextBox}" x:Name="txtUser" TabIndex="4" TextChanged="TextFieldChanged"/>
                    </Border>

                    <Label Style="{StaticResource TextBoxLabel}" Content="کلمه عبور :" Grid.Column="0" Grid.Row="4"
                           HorizontalAlignment="Right" Margin="0,0,8,0"/>
                    <Border Style="{StaticResource InputTextBoxBorder}" Grid.Column="1" Grid.ColumnSpan="2" Grid.Row="4" Margin="0,0,8,0">
                        <PasswordBox Style="{StaticResource InputPasswordBox}" x:Name="txtPassword" TabIndex="5" PasswordChanged="PasswordFieldChanged"/>
                    </Border>

                    <CheckBox x:Name="chkWindowsAuth" Content="استفاده از حساب ویندوز"
                              FontWeight="Bold" FontFamily="Shabnam FD" FontSize="11"
                              Grid.Column="1" Grid.ColumnSpan="2" Grid.Row="5"
                              HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,8,0"
                              TabIndex="6" Checked="chkWindowsAuth_Changed" Unchecked="chkWindowsAuth_Changed"
                              ToolTip="در صورت انتخاب، نام کاربری و کلمه عبور نادیده گرفته می شوند"/>

                    <Label Style="{StaticResource TextBoxLabel}" Content="رشته اتصال :" Grid.Column="0" Grid.Row="6"
                           HorizontalAlignment="Right" Margin="0,0,8,0"/>
                    <Border Style="{StaticResource InputTextBoxBorder}" Grid.Column="1" Grid.ColumnSpan="2" Grid.Row="6" Margin="0,0,8,0">
                        <TextBox Style="{StaticResource InputTextBox}" x:Name="txtConnectionString"
                                 IsReadOnly="True" BorderThickness="0" Padding="2,4,2,4"
                                 FontFamily="Shabnam FD" FontSize="9" TabIndex="7"
                                 ToolTip="رشته اتصالی که ذخیره می شود. شامل کلمه عبور در صورت انتخاب ورود با نام کاربری"/>
                    </Border>

                    <Label Style="{StaticResource TextBoxLabel}" Content="تغییرات :" Grid.Column="0" Grid.Row="7"
                           HorizontalAlignment="Right" Margin="0,0,8,0"/>
                    <TextBlock x:Name="lblDirty" Grid.Column="1" Grid.ColumnSpan="2" Grid.Row="7"
                               FontFamily="Shabnam FD" FontSize="10" HorizontalAlignment="Right"
                               VerticalAlignment="Center" Text="ذخیره نشده" Foreground="#c0392b"/>

                    <Border Style="{StaticResource ButtonBorder}" Grid.Column="1" Grid.Row="8" Margin="0,0,6,0" Height="34">
                        <Button Style="{StaticResource Button}" x:Name="btnTest" Height="30" Click="btnTest_Click" TabIndex="8">
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                <Image Source="/Images/Search.png" Width="16" Height="16" Margin="0,0,7,0"/>
                                <TextBlock Text="آزمایش اتصال"/>
                            </StackPanel>
                        </Button>
                    </Border>

                    <Border Style="{StaticResource ButtonBorder}" Grid.Column="2" Grid.Row="8" Margin="6,0,0,0" Height="34">
                        <Button Style="{StaticResource Button}" x:Name="btnSave" Height="30" Click="btnSave_Click" TabIndex="9">
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                <Image Source="/Images/Checked.png" Width="16" Height="16" Margin="0,0,7,0"/>
                                <TextBlock Text="ذخیره و فعال سازی"/>
                            </StackPanel>
                        </Button>
                    </Border>
                </Grid>
                <!-- ===================== پیکربندی SQL Server ===================== -->

                <!-- ===================== راهنما ===================== -->
                <Grid Margin="0,0,0,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="150"/>
                    </Grid.RowDefinitions>

                    <GroupBox Style="{StaticResource GroupBox}" Header="راهنمای پیکربندی اتصال"
                              Grid.Column="0" Grid.Row="0" Margin="0,0,0,0"/>

                    <TextBlock Grid.Column="0" Grid.Row="0" Margin="12,22,12,8" VerticalAlignment="Top"
                               FontFamily="Shabnam FD" FontSize="10" Foreground="#333333"
                               TextWrapping="Wrap" LineHeight="17">
                        <Run Text="• برنامه به طور پیش‌فرض از SQLite استفاده می‌کند و نیازی به نصب هیچ برنامه‌ای ندارد."/>
                        <LineBreak/>
                        <Run Text="• برای استفاده از SQL Server باید نسخه ۲۰۱۶ یا بالاتر روی همین رایانه نصب باشد."/>
                        <LineBreak/>
                        <Run Text="• نام سرور: برای نمونه پیش‌فرض روی همین رایانه نقطه (.) و برای نمونه‌های نام‌دار همان نام را وارد کنید."/>
                        <LineBreak/>
                        <Run Text="• نام پایگاه داده: در صورت خالی گذاشتن، خود برنامه آن را می‌سازد."/>
                        <LineBreak/>
                        <Run Text="• توصیه می‌شود گزینه استفاده از حساب ویندوز انتخاب شود تا نیازی به ذخیره کلمه عبور نباشد."/>
                        <LineBreak/>
                        <Run Text="• پس از ذخیره، اتصال فقط زمانی ذخیره می‌شود که آزمایش اتصال موفق باشد."/>
                        <LineBreak/>
                        <Run Text="• با غیرفعال کردن اتصال، اطلاعات ذخیره شده حذف نمی‌شود و برنامه به SQLite بازمی‌گردد."/>
                    </TextBlock>
                </Grid>
                <!-- ===================== راهنما ===================== -->

                <!-- ===================== ابزارها ===================== -->
                <Grid Margin="0,0,0,4">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="26"/>
                        <RowDefinition Height="40"/>
                    </Grid.RowDefinitions>

                    <GroupBox Style="{StaticResource GroupBox}" Header="نگهداری پایگاه داده"
                              Grid.ColumnSpan="3" Grid.RowSpan="2" Margin="0,0,0,0"/>

                    <Border Style="{StaticResource ButtonBorder}" Grid.Column="0" Grid.Row="1" Height="32" Margin="0,0,6,0">
                        <Button Style="{StaticResource Button}" x:Name="btnSMSActivation" Height="28"
                                Click="btnSMSActivation_Click" TabIndex="10">
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                <Image Source="/Images/Printer.png" Width="16" Height="16" Margin="0,0,6,0"/>
                                <TextBlock Text="پشتیبان گیری"/>
                            </StackPanel>
                        </Button>
                    </Border>

                    <Border Style="{StaticResource ButtonBorder}" Grid.Column="1" Grid.Row="1" Height="32" Margin="0,0,6,0">
                        <Button Style="{StaticResource Button}" x:Name="btnRestore" Height="28"
                                Click="btnRestore_Click" TabIndex="11">
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                <Image Source="/Images/Edit.png" Width="16" Height="16" Margin="0,0,6,0"/>
                                <TextBlock Text="بازیابی"/>
                            </StackPanel>
                        </Button>
                    </Border>

                    <Border Style="{StaticResource ButtonBorder}" Grid.Column="2" Grid.Row="1" Height="32" Margin="0,0,0,0">
                        <Button Style="{StaticResource Button}" x:Name="btnDeleteDB" Height="28"
                                Background="DarkRed" Click="btnDeleteDB_Click" TabIndex="12">
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                <Image Source="/Images/Delete.png" Width="16" Height="16" Margin="0,0,6,0"/>
                                <TextBlock Text="حذف فایل SQLite"/>
                            </StackPanel>
                        </Button>
                    </Border>
                </Grid>
                <!-- ===================== ابزارها ===================== -->

            </StackPanel>
        </ScrollViewer>

        <Image Style="{StaticResource BackToHomeImage}" x:Name="BackToSetting"
               Grid.Column="0" Grid.Row="1" HorizontalAlignment="Left" VerticalAlignment="Center"
               Margin="12,0,0,0" Cursor="Hand" MouseLeftButtonDown="BackToSetting_MouseLeftButtonDown"/>
    </Grid>
</Window>
