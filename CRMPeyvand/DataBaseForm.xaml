<Window x:Class="CRMPeyvand.DataBaseForm"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:CRMPeyvand"
        mc:Ignorable="d"

        ResizeMode="CanResize" MinHeight="560" MinWidth="520"
        WindowStyle="None"
        WindowStartupLocation="CenterScreen"
        Background="Transparent"
        AllowsTransparency="True"
        FlowDirection="RightToLeft"

        Title="DataBaseForm" Height="700" Width="560"
        Loaded="Window_Loaded" PreviewKeyDown="Window_PreviewKeyDown">

    <!--
        Two layout rules the rest of this file depends on, both learned from the
        rendering:

        1. The shared "Button" style hard-codes Width=170, so a Button inside a
           wider ButtonBorder leaves a border with a patch of background floating
           in the middle. A full-width button therefore has to say Width="NaN"
           and stretch; a fixed one has to match its border's width exactly.

        2. Under this window's RightToLeft flow, HorizontalAlignment="Right" put
           the two status texts at the physical LEFT of their cell. Aligning them
           to the right-hand edge of the text boxes is therefore done by pinning
           the wrapper grid to LeftToRight and right-aligning inside that, while
           each element keeps RightToLeft for its own text.
    -->
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="46"/>
        </Grid.RowDefinitions>

        <Border Grid.Column="0" Grid.Row="0" Grid.RowSpan="2" BorderThickness="5" BorderBrush="#eeeeee" CornerRadius="10">
            <Rectangle Fill="#eeeeee"/>
        </Border>

        <ScrollViewer Grid.Column="0" Grid.Row="0" VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled" Padding="8,10,8,4">
            <StackPanel>

                <!-- ===================== وضعیت پایگاه داده ===================== -->
                <Grid Margin="0,0,0,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="125"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <!-- Empty top row: the GroupBox header is drawn over row 0,
                             so the first real row has to start below it. The
                             configuration section below already has one. -->
                        <RowDefinition Height="24"/>
                        <RowDefinition Height="26"/>
                        <RowDefinition Height="34"/>
                        <RowDefinition Height="30"/>
                        <RowDefinition Height="34"/>
                    </Grid.RowDefinitions>

                    <GroupBox Style="{StaticResource GroupBox}" Header="وضعیت پایگاه داده"
                              Grid.ColumnSpan="2" Grid.RowSpan="5"/>

                    <Label Style="{StaticResource TextBoxLabel}" Content="پایگاه داده فعال :"
                           Grid.Column="0" Grid.Row="1" HorizontalAlignment="Right" Margin="0,0,8,0"/>
                    <Grid Grid.Column="1" Grid.Row="1" FlowDirection="LeftToRight">
                        <TextBlock x:Name="lblActiveProvider" FlowDirection="RightToLeft"
                                   FontFamily="Shabnam FD" FontSize="12" FontWeight="Bold" Foreground="#0d63f1"
                                   HorizontalAlignment="Right" VerticalAlignment="Center" Text="—"/>
                    </Grid>

                    <Label Style="{StaticResource TextBoxLabel}" Content="محل فایل SQLite :"
                           Grid.Column="0" Grid.Row="2" HorizontalAlignment="Right" Margin="0,0,8,0"/>
                    <Border Style="{StaticResource InputTextBoxBorder}" Width="NaN" Grid.Column="1" Grid.Row="2" Margin="0,0,8,0">
                        <TextBox Style="{StaticResource InputTextBox}" x:Name="txtSqlitePath"
                                 IsReadOnly="True" BorderThickness="0" Padding="2,5,2,4"
                                 FontFamily="Shabnam FD" FontSize="10" TabIndex="0"/>
                    </Border>

                    <Label Style="{StaticResource TextBoxLabel}" Content="وضعیت فایل :"
                           Grid.Column="0" Grid.Row="3" HorizontalAlignment="Right" Margin="0,0,8,0"/>
                    <Grid Grid.Column="1" Grid.Row="3" FlowDirection="LeftToRight">
                        <TextBlock x:Name="lblSqliteExists" FlowDirection="RightToLeft"
                                   FontFamily="Shabnam FD" FontSize="11"
                                   HorizontalAlignment="Right" VerticalAlignment="Center" Text="—"/>
                    </Grid>

                    <!-- Full width: the button stretches so its own background
                         covers the border instead of floating inside it. -->
                    <Border Style="{StaticResource ButtonBorder}" Grid.Column="0" Grid.ColumnSpan="2" Grid.Row="4"
                            Height="32" Margin="0,2,0,0">
                        <Button Style="{StaticResource Button}" x:Name="btnToggleSqlServer"
                                Width="NaN" Height="32"
                                HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                                Click="btnToggleSqlServer_Click" TabIndex="1">
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                <Image Source="/Images/Display.png" Width="17" Height="17" Margin="0,0,7,0"/>
                                <TextBlock x:Name="btnToggleSqlServerText" Text="فعال کردن اتصال SQL Server"
                                           FontFamily="Shabnam FD" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                    </Border>
                </Grid>
                <!-- ===================== وضعیت پایگاه داده ===================== -->

                <!-- ===================== پیکربندی SQL Server ===================== -->
                <Grid Margin="0,0,0,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="125"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="30"/>
                        <RowDefinition Height="34"/>
                        <RowDefinition Height="34"/>
                        <RowDefinition Height="34"/>
                        <RowDefinition Height="34"/>
                        <RowDefinition Height="30"/>
                        <RowDefinition Height="56"/>
                        <RowDefinition Height="28"/>
                        <RowDefinition Height="40"/>
                    </Grid.RowDefinitions>

                    <GroupBox Style="{StaticResource GroupBox}" Header="پیکربندی SQL Server"
                              Grid.ColumnSpan="2" Grid.RowSpan="9"/>

                    <Label Style="{StaticResource TextBoxLabel}" Content="نام سرور :" Grid.Column="0" Grid.Row="1"
                           HorizontalAlignment="Right" Margin="0,0,8,0"/>
                    <Border Style="{StaticResource InputTextBoxBorder}" Width="NaN" Grid.Column="1" Grid.Row="1" Margin="0,0,8,0">
                        <TextBox Style="{StaticResource InputTextBox}" x:Name="txtServer" TabIndex="2"
                                 TextChanged="TextFieldChanged"
                                 ToolTip="نام سرور یا نمونه محلی. برای نمونه پیش‌فرض روی همین رایانه نقطه بنویسید"/>
                    </Border>

                    <Label Style="{StaticResource TextBoxLabel}" Content="نام پایگاه داده :" Grid.Column="0" Grid.Row="2"
                           HorizontalAlignment="Right" Margin="0,0,8,0"/>
                    <Border Style="{StaticResource InputTextBoxBorder}" Width="NaN" Grid.Column="1" Grid.Row="2" Margin="0,0,8,0">
                        <TextBox Style="{StaticResource InputTextBox}" x:Name="txtDatabase" TabIndex="3"
                                 TextChanged="TextFieldChanged"
                                 ToolTip="نام پایگاه داده. در صورت خالی بودن، خود برنامه آن را می سازد"/>
                    </Border>

                    <Label Style="{StaticResource TextBoxLabel}" Content="نام کاربری :" Grid.Column="0" Grid.Row="3"
                           HorizontalAlignment="Right" Margin="0,0,8,0"/>
                    <Border Style="{StaticResource InputTextBoxBorder}" Width="NaN" Grid.Column="1" Grid.Row="3" Margin="0,0,8,0">
                        <TextBox Style="{StaticResource InputTextBox}" x:Name="txtUser" TabIndex="4"
                                 TextChanged="TextFieldChanged"/>
                    </Border>

                    <Label Style="{StaticResource TextBoxLabel}" Content="کلمه عبور :" Grid.Column="0" Grid.Row="4"
                           HorizontalAlignment="Right" Margin="0,0,8,0"/>
                    <Border Style="{StaticResource InputTextBoxBorder}" Width="NaN" Grid.Column="1" Grid.Row="4" Margin="0,0,8,0">
                        <PasswordBox Style="{StaticResource InputPasswordBox}" x:Name="txtPassword" TabIndex="5"
                                     PasswordChanged="PasswordFieldChanged"/>
                    </Border>

                    <!-- Sits directly under the text boxes, hard against the edge
                         they start from. -->
                    <Grid Grid.Column="1" Grid.Row="5" FlowDirection="LeftToRight">
                        <CheckBox x:Name="chkWindowsAuth" FlowDirection="RightToLeft" Content="استفاده از حساب ویندوز"
                                  FontWeight="Bold" FontFamily="Shabnam FD" FontSize="11"
                                  HorizontalAlignment="Right" VerticalAlignment="Center"
                                  TabIndex="6" Checked="chkWindowsAuth_Changed" Unchecked="chkWindowsAuth_Changed"
                                  ToolTip="در صورت انتخاب، نام کاربری و کلمه عبور نادیده گرفته می شوند"/>
                    </Grid>

                    <Label Style="{StaticResource TextBoxLabel}" Content="رشته اتصال :" Grid.Column="0" Grid.Row="6"
                           HorizontalAlignment="Right" Margin="0,0,8,0"/>
                    <Border Style="{StaticResource InputTextBoxBorder}" Width="NaN" Height="NaN" Grid.Column="1" Grid.Row="6" Margin="0,0,8,0">
                        <!-- Taller than the other fields: the connection string wraps
                             onto two or three lines at this size, and the shared
                             border style's fixed 30px height was clipping the last
                             line. -->
                        <TextBox Style="{StaticResource InputTextBox}" x:Name="txtConnectionString"
                                 Height="46" VerticalAlignment="Top"
                                 IsReadOnly="True" BorderThickness="0" Padding="2,4,2,4"
                                 FontFamily="Shabnam FD" FontSize="9" TabIndex="7"
                                 ToolTip="رشته اتصالی که ذخیره می شود. شامل کلمه عبور در صورت انتخاب ورود با نام کاربری"/>
                    </Border>

                    <Label Style="{StaticResource TextBoxLabel}" Content="تغییرات :" Grid.Column="0" Grid.Row="7"
                           HorizontalAlignment="Right" Margin="0,0,8,0"/>
                    <Grid Grid.Column="1" Grid.Row="7" FlowDirection="LeftToRight">
                        <TextBlock x:Name="lblDirty" FlowDirection="RightToLeft"
                                   FontFamily="Shabnam FD" FontSize="10"
                                   HorizontalAlignment="Right" VerticalAlignment="Center"
                                   Text="ذخیره نشده" Foreground="#c0392b"/>
                    </Grid>

                    <!-- Two fixed-width buttons, centred as a pair. Each border is
                         170 wide to match the button width the style imposes. -->
                    <Grid Grid.Column="0" Grid.ColumnSpan="2" Grid.Row="8">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                            <Border Style="{StaticResource ButtonBorder}" Width="172" Height="32" Margin="0,0,8,0">
                                <Button Style="{StaticResource Button}" x:Name="btnTest" Height="32"
                                        VerticalAlignment="Stretch" Click="btnTest_Click" TabIndex="8">
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                        <Image Source="/Images/Search.png" Width="16" Height="16" Margin="0,0,7,0"/>
                                        <TextBlock Text="آزمایش اتصال" FontFamily="Shabnam FD" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Button>
                            </Border>

                            <Border Style="{StaticResource ButtonBorder}" Width="172" Height="32" Margin="8,0,0,0">
                                <Button Style="{StaticResource Button}" x:Name="btnSave" Height="32"
                                        VerticalAlignment="Stretch" Click="btnSave_Click" TabIndex="9">
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                        <Image Source="/Images/Checked.png" Width="16" Height="16" Margin="0,0,7,0"/>
                                        <TextBlock Text="ذخیره و فعال سازی" FontFamily="Shabnam FD" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Button>
                            </Border>
                        </StackPanel>
                    </Grid>
                </Grid>
                <!-- ===================== پیکربندی SQL Server ===================== -->

                <!-- ===================== ابزارها ===================== -->
                <Grid Margin="0,0,0,4">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="26"/>
                        <RowDefinition Height="40"/>
                    </Grid.RowDefinitions>

                    <GroupBox Style="{StaticResource GroupBox}" Header="نگهداری پایگاه داده"
                              Grid.Column="0" Grid.RowSpan="2"/>

                    <StackPanel Grid.Column="0" Grid.Row="1" Orientation="Horizontal"
                                HorizontalAlignment="Center" VerticalAlignment="Center">

                        <Border Style="{StaticResource ButtonBorder}" Width="172" Height="32" Margin="0,0,8,0">
                            <Button Style="{StaticResource Button}" x:Name="btnSMSActivation" Height="32"
                                    VerticalAlignment="Stretch" Click="btnSMSActivation_Click" TabIndex="10">
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <Image Source="/Images/Printer.png" Width="16" Height="16" Margin="0,0,6,0"/>
                                    <TextBlock Text="پشتیبان گیری" FontFamily="Shabnam FD" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                        </Border>

                        <Border Style="{StaticResource ButtonBorder}" Width="172" Height="32" Margin="0,0,8,0">
                            <Button Style="{StaticResource Button}" x:Name="btnRestore" Height="32"
                                    VerticalAlignment="Stretch" Click="btnRestore_Click" TabIndex="11">
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <Image Source="/Images/Edit.png" Width="16" Height="16" Margin="0,0,6,0"/>
                                    <TextBlock Text="بازیابی" FontFamily="Shabnam FD" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                        </Border>

                        <Border Style="{StaticResource ButtonBorder}" Width="172" Height="32" Margin="0,0,0,0"
                                BorderBrush="DarkRed">
                            <Button Style="{StaticResource Button}" x:Name="btnDeleteDB" Height="32"
                                    Background="DarkRed" BorderBrush="DarkRed"
                                    VerticalAlignment="Stretch" Click="btnDeleteDB_Click" TabIndex="12">
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <Image Source="/Images/Delete.png" Width="16" Height="16" Margin="0,0,6,0"/>
                                    <TextBlock Text="حذف فایل SQLite" FontFamily="Shabnam FD" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                        </Border>
                    </StackPanel>
                </Grid>
                <!-- ===================== ابزارها ===================== -->

                <!-- The guidelines live on their own page, so this window stays
                     short enough not to need scrolling on a 768px screen. -->
                <Border Style="{StaticResource ButtonBorder}" Width="220" Height="32"
                        HorizontalAlignment="Center" Margin="0,2,0,8">
                    <Button Style="{StaticResource Button}" x:Name="btnGuide" Width="220" Height="32"
                            VerticalAlignment="Stretch" Click="btnGuide_Click" TabIndex="13">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                            <Image Source="/Images/Info.png" Width="16" Height="16" Margin="0,0,7,0"/>
                            <TextBlock Text="راهنمای پیکربندی اتصال" FontFamily="Shabnam FD" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                </Border>

            </StackPanel>
        </ScrollViewer>

        <Image Style="{StaticResource BackToHomeImage}" x:Name="BackToSetting"
               Grid.Column="0" Grid.Row="1" HorizontalAlignment="Left" VerticalAlignment="Center"
               Margin="12,0,0,0" Cursor="Hand" MouseLeftButtonDown="BackToSetting_MouseLeftButtonDown"/>
    </Grid>
</Window>
