<Window
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:CRMPeyvand"
        xmlns:hc="https://handyorg.github.io/handycontrol" x:Class="CRMPeyvand.AboutUsForm"
        mc:Ignorable="d"
                ResizeMode="NoResize"
        WindowStyle="None"
        WindowStartupLocation="CenterScreen"
        Background="Transparent"
        AllowsTransparency="True"
        FlowDirection="RightToLeft"


        Title="AboutUsForm" Height="400" Width="900" PreviewKeyDown="Window_PreviewKeyDown">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition/>
            <ColumnDefinition/>
            <ColumnDefinition/>
            <ColumnDefinition/>
            <ColumnDefinition/>
            <ColumnDefinition/>
            <ColumnDefinition/>
            <ColumnDefinition/>
            <ColumnDefinition/>
            <ColumnDefinition/>
            <ColumnDefinition/>
            <ColumnDefinition/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition/>
            <RowDefinition/>
            <RowDefinition />
            <RowDefinition Height="33.333"/>
            <RowDefinition/>
            <RowDefinition/>
            <RowDefinition/>
            <RowDefinition/>
            <RowDefinition/>
            <RowDefinition/>
            <RowDefinition/>
            <RowDefinition/>
        </Grid.RowDefinitions>
        <!--Background-->
        <Border Grid.ColumnSpan="12" Grid.RowSpan="12" BorderThickness="5" BorderBrush="#eeeeee" CornerRadius="10">
            <Rectangle Fill="#eeeeee"/>
        </Border>
        <!--Background-->

        <!--SoftWare-->
        <GroupBox Style="{StaticResource GroupBox}" Header="نرم افزار" Grid.ColumnSpan="12" Grid.RowSpan="6" Margin="10,5,10,10" />
        <Image Source="/Images/PeyvandLogo.png" Grid.ColumnSpan="2" Margin="3,22,62,11" Grid.Row="1" Grid.RowSpan="2" />
        <Label Style="{StaticResource TextBoxLabel}" Content="پیوند" FontWeight="Bold" FontSize="17" Foreground="#4A8FE7" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="56,22,0,0" Grid.ColumnSpan="3" Width="100" Grid.Row="1" Grid.RowSpan="2"/>
        <Label Style="{StaticResource TextBoxLabel}" Grid.Column="0" FontSize="13" 
               Content="پیوند نرم افزاری برای ایجاد ارتباط محکم بین شما"
               HorizontalAlignment="Left" Grid.Row="2" VerticalAlignment="Top" Grid.ColumnSpan="5" Height="26" Width="265" Margin="20,25,0,0" Grid.RowSpan="2"/>
        <Label Style="{StaticResource TextBoxLabel}" Grid.Column="0" FontSize="13" 
               Content="و مشتریانتان همچنین مدیریت کالاها و مشتریان"
               HorizontalAlignment="Left" Grid.Row="3" VerticalAlignment="Top" Grid.ColumnSpan="5" Height="26" Width="265" Margin="20,11,0,0" Grid.RowSpan="2"/>
        <Label Style="{StaticResource TextBoxLabel}" Grid.Column="0" FontSize="13 " 
               Content="در بستر یک برنامه میباشد."
               HorizontalAlignment="Left" Grid.Row="3" VerticalAlignment="Top" Grid.ColumnSpan="4" Height="26" Width="228" Margin="20,31,0,0" Grid.RowSpan="2"/>
        <Border CornerRadius="10"  BorderThickness="3" BorderBrush="#4A8FE7" Grid.Column="4" Margin="21,23,0,2" Grid.Row="1" HorizontalAlignment="Left" Width="8">
            <Rectangle Fill="#4A8FE7" Width="5" Height="5" HorizontalAlignment="Center" VerticalAlignment="Center"/>
        </Border>

        <Label Style="{StaticResource TextBoxLabel}" Grid.Column="4" FontSize="11" 
               Content="مدیریت مشتریان و کالاها"
               HorizontalAlignment="Left" VerticalAlignment="Top" Margin="33,16,0,0" Grid.ColumnSpan="4" Height="26" Width="228" Grid.Row="1" Grid.RowSpan="2"/>
        <Border CornerRadius="10"  BorderThickness="3" BorderBrush="#4A8FE7" Grid.Column="4" Margin="21,9,0,16" Grid.Row="2" HorizontalAlignment="Left" Width="8">
            <Rectangle Fill="#4A8FE7" Width="5" Height="5" HorizontalAlignment="Center" VerticalAlignment="Center"/>
        </Border>

        <Label Style="{StaticResource TextBoxLabel}" Grid.Column="4" FontSize="11" 
               Content="ایجاد و مدیریت فعالیت ها و یادآور ها"
               HorizontalAlignment="Left" VerticalAlignment="Top" Margin="33,1,0,0" Grid.ColumnSpan="4" Height="26" Width="228" Grid.Row="2"/>
        <Border CornerRadius="10"  BorderThickness="3" BorderBrush="#4A8FE7" Grid.Column="4" Margin="21,30,0,29" Grid.Row="2" HorizontalAlignment="Left" Width="8" Grid.RowSpan="2">
            <Rectangle Fill="#4A8FE7" Width="5" Height="5" HorizontalAlignment="Center" VerticalAlignment="Center"/>
        </Border>

        <Label Style="{StaticResource TextBoxLabel}" Grid.Column="4" FontSize="11" 
               Content="ایجاد و مدیریت کاربران و سطح دسترسی ها"
               HorizontalAlignment="Left" VerticalAlignment="Top" Margin="33,22,0,0" Grid.ColumnSpan="4" Height="26" Width="228" Grid.Row="2" Grid.RowSpan="2"/>
        <Border CornerRadius="10"  BorderThickness="3" BorderBrush="#4A8FE7" Grid.Column="4" Margin="21,17,0,8" Grid.Row="3" HorizontalAlignment="Left" Width="8">
            <Rectangle Fill="#4A8FE7" Width="5" Height="5" HorizontalAlignment="Center" VerticalAlignment="Center"/>
        </Border>

        <Label Style="{StaticResource TextBoxLabel}" Grid.Column="4" FontSize="11" 
               Content="ایجاد و ثبت فاکتور و گزارش گیری های متنوع"
               HorizontalAlignment="Left" VerticalAlignment="Top" Margin="33,12,0,0" Grid.ColumnSpan="4" Height="26" Width="228" Grid.Row="3" Grid.RowSpan="2"/>
        <Border CornerRadius="10"  BorderThickness="3" BorderBrush="#4A8FE7" Grid.Column="4" Margin="21,7,0,18" Grid.Row="4" HorizontalAlignment="Left" Width="8">
            <Rectangle Fill="#4A8FE7" Width="5" Height="5" HorizontalAlignment="Center" VerticalAlignment="Center"/>
        </Border>

        <Label Style="{StaticResource TextBoxLabel}" Grid.Column="4" FontSize="11" 
               Content="مدیریت پنل پیامکی و ایجاد کد تخفیف شخصی سازی شده"
               HorizontalAlignment="Left" VerticalAlignment="Top" Margin="33,33,0,0" Grid.ColumnSpan="5" Height="28" Width="272" Grid.Row="3" Grid.RowSpan="2"/>

        <Label Style="{StaticResource TextBoxLabel}" Grid.Column="7" FontSize="11" 
               Content="راهنمای کاربر :"
               HorizontalAlignment="Left" VerticalAlignment="Top" Margin="51,16,0,0" Grid.ColumnSpan="4" Height="26" Width="228" Grid.RowSpan="2" Grid.Row="1"/>

        <Label Style="{StaticResource TextBoxLabel}" Grid.Column="7" FontSize="10" 
               Content="در هر فرم برنامه با استفاده از کلید Escape میتوانید فرم جاری را ببندید."
               HorizontalAlignment="Left" VerticalAlignment="Top" Margin="51,0,0,0" Grid.ColumnSpan="5" Height="25" Width="305" Grid.Row="2"/>

        <Label Style="{StaticResource TextBoxLabel}" Grid.Column="7" FontSize="10"
               HorizontalAlignment="Left" VerticalAlignment="Top" Margin="51,14,0,0" Grid.ColumnSpan="5" Height="25" Width="302" Grid.Row="2" Grid.RowSpan="2"/>

        <Label Style="{StaticResource TextBoxLabel}" Grid.Column="7" FontSize="10" 
               Content="هنگام ثبت فاکتور تعداد کالاها از انبار کم میشود.از ثبت فاکتور بیهوده و یا"
               HorizontalAlignment="Left" VerticalAlignment="Top" Margin="51,29,0,0" Grid.ColumnSpan="5" Height="25" Width="305" Grid.Row="2" Grid.RowSpan="2"/>

        <Label Style="{StaticResource TextBoxLabel}" Grid.Column="7" FontSize="10" 
               Content="اشتباه اجتناب کنید."
               HorizontalAlignment="Left" VerticalAlignment="Top" Margin="51,11,0,0" Grid.ColumnSpan="4" Height="25" Width="246" Grid.Row="3" Grid.RowSpan="2"/>
        <!--SoftWare-->

        <!--Developer-->
        <GroupBox Style="{StaticResource GroupBox}" Header="برنامه نویس" Grid.ColumnSpan="3" Grid.RowSpan="4" Margin="10,5,59,4" Grid.Row="6" />

        <Label Style="{StaticResource TextBoxLabel}" Grid.Column="0" FontSize="11" 
               Content="احسان شریعتی فر"
               HorizontalAlignment="Left" Grid.Row="6" VerticalAlignment="Top" Grid.ColumnSpan="4" Height="26" Width="228" Margin="29,31,0,0" Grid.RowSpan="2"/>

        <Label Style="{StaticResource TextBoxLabel}" Grid.Column="0" FontSize="11" 
               Content="رشته :  نرم افزار کامپیوتر"
               HorizontalAlignment="Left" Grid.Row="7" VerticalAlignment="Top" Grid.ColumnSpan="4" Height="27" Width="228" Margin="30,21,0,0" Grid.RowSpan="2"/>

        <Label Style="{StaticResource TextBoxLabel}" Grid.Column="0" FontSize="11" 
               Content="راه ارتباطی :"
               HorizontalAlignment="Left" Grid.Row="8" VerticalAlignment="Top" Grid.ColumnSpan="4" Height="28" Width="228" Margin="30,9,0,0" Grid.RowSpan="2"/>

        <Label Style="{StaticResource TextBoxLabel}" Grid.Column="0" FontSize="11" 
               Content="09331138407"
               HorizontalAlignment="Left" Grid.Row="8" VerticalAlignment="Top" Grid.ColumnSpan="4" Height="28" Width="228" Margin="30,28,0,0" Grid.RowSpan="2"/>

        <!--Developer-->

        <Image Style="{StaticResource BackToHomeImage}" Grid.Column="11" Margin="9,14,15,13" Grid.RowSpan="2" Grid.Row="10" RenderTransformOrigin="0.49,0.485" MouseLeftButtonDown="Image_MouseLeftButtonDown"/>
    </Grid>
</Window>
